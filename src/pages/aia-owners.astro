    }
    .winners-sub strong { color: var(--color-navy); font-weight: 700; }
    .winners-grid {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem;
    }
    .winners-card {
      background: var(--color-warm-white);
      border: 1px solid rgba(26,26,46,0.08);
      border-radius: 12px;
      padding: 1.6rem 1.5rem;
      position: relative;
    }
    .winners-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0;
      height: 3px; background: var(--color-teal);
      border-radius: 12px 12px 0 0;
    }
    .winners-num {
      font-family: var(--font-mono); font-size: 0.7rem;
      font-weight: 700; letter-spacing: 0.22em;
      color: var(--color-teal); display: block; margin-bottom: 0.85rem;
    }
    .winners-q {
      font-family: var(--font-heading); font-weight: 700;
      font-size: 1.5rem; line-height: 1.2;
      letter-spacing: -0.02em; color: var(--color-deep); margin: 0;
    }
    .winners-q em { color: var(--color-amber); font-style: italic; font-weight: 800; }

    /* ══════════════════════════════════════════════════════
       SLIDE 08 — Cultivated AI · five stages (imported)
       ══════════════════════════════════════════════════════ */
    .slide-stages { justify-content: center; }
    .stages-content { max-width: 1400px; margin: 0 auto; width: 100%; }
    .stages-headline {
      font-family: var(--font-heading); font-weight: 800;
      font-size: clamp(2.5rem, 4.5vw, 3.5rem);
      letter-spacing: -0.03em; line-height: 1.05;
      margin: 0 0 2.5rem; color: var(--color-deep); text-align: center;
    }
    .stages-headline em { font-style: italic; color: var(--color-amber); }
    .stages-headline.stages-wordmark {
      font-size: clamp(3.5rem, 6.5vw, 5.5rem);
      margin: 0 0 3rem;
    }
    .stages-grid {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem;
    }
    .stage-card {
      background: var(--color-warm-white);
      border: 1px solid rgba(26,26,46,0.07);
      border-radius: 12px; padding: 1.5rem 1.25rem;
      position: relative; overflow: hidden;
    }
    .stage-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    }
    .stage-card.s1::before { background: var(--color-amber); }
    .stage-card.s2::before { background: var(--color-teal); }
    .stage-card.s3::before { background: var(--color-purple); }
    .stage-card.s4::before { background: var(--color-accent-red); }
    .stage-num {
      font-family: var(--font-mono); font-size: 0.7rem;
      font-weight: 600; letter-spacing: 0.2em;
      text-transform: uppercase; color: var(--color-subtle);
      margin-bottom: 0.5rem;
    }
    .stage-title {
      font-family: var(--font-heading); font-weight: 800;
      font-size: 1.4rem; letter-spacing: -0.02em;
      line-height: 1.1; margin: 0 0 0.65rem;
    }
    .stage-card.s1 .stage-title { color: var(--color-amber); }
    .stage-card.s2 .stage-title { color: var(--color-teal); }
    .stage-card.s3 .stage-title { color: var(--color-purple); }
    .stage-card.s4 .stage-title { color: var(--color-accent-red); }
    .stage-tag {
      font-family: var(--font-body); font-size: 0.92rem;
      line-height: 1.45; color: var(--color-deep); margin: 0;
    }
    .stages-meta {
      margin: 2.5rem auto 0; max-width: 800px;
      display: flex; flex-direction: column; gap: 0.45rem;
    }
    .stages-meta > div {
      display: grid; grid-template-columns: 100px 1fr;
      gap: 1.25rem; align-items: baseline;
      padding: 0.5rem 0; border-bottom: 1px solid rgba(26,26,46,0.07);
    }
    .stages-meta > div:last-child { border-bottom: none; }
    .stages-meta dt {
      font-family: var(--font-mono); font-size: 0.7rem;
      font-weight: 700; letter-spacing: 0.22em;
      text-transform: uppercase; color: var(--color-amber); margin: 0;
    }
    .stages-meta dd {
      font-family: var(--font-body); font-size: 1.05rem;
      line-height: 1.4; color: var(--color-deep); margin: 0;
    }

    /* ══════════════════════════════════════════════════════
       SLIDE 09 — The workshop (Cultivated AI for Owners)
       ══════════════════════════════════════════════════════ */
    .slide-workshop { padding: 3.5rem 5rem; }
    .ws-content { max-width: 1400px; margin: 0 auto; width: 100%; }
    .ws-eyebrow {
      font-family: var(--font-mono); font-size: 0.78rem;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--color-amber); margin: 0 0 0.85rem;
    }
    .ws-headline {
      font-family: var(--font-heading); font-weight: 800;
      font-size: clamp(2.2rem, 3.8vw, 3.2rem); line-height: 1.05;
      color: var(--color-deep); letter-spacing: -0.02em; margin: 0 0 0.5rem;
    }
    .ws-headline em { font-style: italic; color: var(--color-navy); font-weight: 800; }
    .ws-sub {
      font-family: var(--font-body); font-size: 1.05rem;
      color: var(--color-subtle); margin: 0 0 2rem; max-width: 1000px;
    }
    .ws-sub em { font-style: italic; color: var(--color-deep); font-weight: 600; }
    .ws-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem;
      margin-bottom: 2rem;
    }
    .ws-card {
      padding: 1.5rem 1.6rem; background: var(--color-warm-white);
      border-top: 4px solid var(--color-amber); border-radius: 4px;
      box-shadow: 0 2px 14px rgba(26,26,46,0.05);
    }
    .ws-card .ws-num {
      font-family: var(--font-mono); font-size: 0.7rem;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--color-amber); margin: 0 0 0.4rem;
    }
    .ws-card .ws-title {
      font-family: var(--font-heading); font-weight: 700;
      font-size: 1.5rem; color: var(--color-deep);
      margin: 0 0 0.55rem; letter-spacing: -0.01em;
    }
    .ws-card .ws-body {
      font-family: var(--font-body); font-size: 0.92rem;
      line-height: 1.55; color: var(--color-deep); margin: 0;
    }
    .ws-card .ws-body em { font-style: italic; color: var(--color-navy); font-weight: 600; }
    .ws-meta {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem;
      padding: 1.1rem 0 0; border-top: 1px solid rgba(26,26,46,0.1);
      margin: 0;
    }
    .ws-meta div { margin: 0; }
    .ws-meta dt {
      font-family: var(--font-mono); font-size: 0.7rem;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--color-subtle); margin-bottom: 0.3rem;
    }
    .ws-meta dd {
      font-family: var(--font-body); font-size: 0.95rem;
      color: var(--color-deep); margin: 0; line-height: 1.4;
    }
    .ws-meta dd em { font-style: italic; color: var(--color-navy); font-weight: 600; }

    /* lean workshop additions */
    .ws-lead {
      font-family: var(--font-body);
      font-size: 1.35rem; line-height: 1.55;
      color: var(--color-deep);
      max-width: 1150px; margin: 0 0 2rem;
    }
    .ws-lead em { font-style: italic; color: var(--color-navy); font-weight: 700; }
    .ws-functions {
      display: flex; flex-wrap: wrap;
      gap: 0.7rem 0.85rem;
      margin: 0 0 2rem;
      padding: 1.4rem 0;
      border-top: 1px solid rgba(26,26,46,0.08);
      border-bottom: 1px solid rgba(26,26,46,0.08);
    }
    .ws-fn {
      font-family: var(--font-mono);
      font-size: 0.8rem; font-weight: 700;
      letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--color-navy);
      padding: 0.5rem 0.9rem;
      background: rgba(15,52,96,0.06);
      border-radius: 100px;
    }
    .ws-outcome {
      font-family: var(--font-heading); font-style: italic;
      font-size: clamp(1.4rem, 2.2vw, 1.7rem);
      line-height: 1.35;
      color: var(--color-deep); margin: 0;
      letter-spacing: -0.005em;
      max-width: 1100px;
    }
    .ws-outcome em { color: var(--color-amber); font-weight: 800; font-style: italic; }

    /* ══════════════════════════════════════════════════════
       SLIDE 05 — Close
       ══════════════════════════════════════════════════════ */
    .slide-close { align-items: center; justify-content: center; text-align: center; }
    .close-thesis {
      font-family: var(--font-heading); font-weight: 800;
      font-size: clamp(2rem, 3.6vw, 3rem); line-height: 1.18;
      color: var(--color-deep); letter-spacing: -0.02em;
      max-width: 1100px; margin: 0 auto 2.4rem;
    }
    .close-thesis .strike {
      text-decoration: line-through; text-decoration-thickness: 2px;
      color: var(--color-accent-red); font-weight: 700;
    }
    .close-thesis em { font-style: italic; color: var(--color-navy); font-weight: 800; }
    .close-divider {
      width: 80px; height: 2px; background: var(--color-navy);
      margin: 0 auto 1.8rem; opacity: 0.4;
    }
    .close-wordmark {
      font-family: var(--font-heading); font-weight: 800;
      font-size: clamp(2.6rem, 5vw, 4rem); line-height: 1;
      color: var(--color-deep); letter-spacing: -0.03em; margin: 0 0 0.6rem;
    }
    .close-wordmark .ai { font-style: italic; color: var(--color-navy); }
    .close-sub {
      font-family: var(--font-mono); font-size: 0.85rem;
      letter-spacing: 0.28em; text-transform: uppercase;
      color: var(--color-subtle); margin: 0 0 1.2rem;
    }
    .close-sub .accent { color: var(--color-navy); }
    .close-email {
      font-family: var(--font-mono); font-size: 0.95rem;
      color: var(--color-deep); margin: 0;
    }
  </style>
</head>
<body class="card-deck-page">

  <nav class="progress-rail" aria-label="Slide progress">
    {slides.map(() => (<span class="progress-dot"></span>))}
  </nav>

  <div class="kbd-hint" id="kbd-hint">
    Use <kbd>&larr;</kbd> <kbd>&rarr;</kbd> or click edges
  </div>

  <div class="card-deck-container" id="deck">

    <!-- ═══ 01 · Cover ═══ -->
    <section class="card-deck-card deck-slide slide-cover" data-slide="cover">
      <div class="stagger">
        <p class="cover-eyebrow">For Owners <span class="dot">·</span> Leadership Literacy</p>
        <h1 class="wordmark">Cultivated <span class="ai">AI</span></h1>
        <p class="verb-pair"><span class="grow">Grow</span>, don't <span class="chase">Chase</span>.</p>
        <p class="cover-context">AIA Engineering <span class="pipe">|</span> Ahmedabad <span class="pipe">|</span> May 2026</p>
      </div>
      <div class="brand-mark">Cultivated AI &middot; <span class="b-grow">For Owners</span></div>
      <div class="slide-num">01 &middot; Cover</div>
    </section>

    <!-- ═══ 02 · The fluency rubric ═══ -->
    <section class="card-deck-card deck-slide slide-rubric" data-slide="rubric">
      <div class="rubric-content stagger">
        <h1 class="rubric-headline">AI <em>fluency</em> levels.</h1>
        <ol class="rubric-grid">
          <li class="rubric-rung r1">
            <p class="rubric-num">Level 1</p>
            <h3 class="rubric-name">Spectator.</h3>
            <p class="rubric-line">AI is an IT line item. Hasn't opened a model this month. Vendors set the agenda by default.</p>
          </li>
          <li class="rubric-rung r2">
            <p class="rubric-num">Level 2</p>
            <h3 class="rubric-name">Tourist.</h3>
            <p class="rubric-line">Has seen what AI can do. Uses it occasionally for an email or a search. Doesn't lead a deployment.</p>
          </li>
          <li class="rubric-rung r3">
            <p class="rubric-num">Level 3</p>
            <h3 class="rubric-name">Operator.</h3>
            <p class="rubric-line">Has favourite prompts for the job. Uses AI daily. Pushes their function to adopt what works.</p>
          </li>
          <li class="rubric-rung r4">
            <p class="rubric-num">Level 4</p>
            <h3 class="rubric-name">Architect.</h3>
            <p class="rubric-line">Asks "what can only AIA build?" Sees the moat in the data. Sets build-vs-buy from first principles.</p>
          </li>
        </ol>
        <p class="rubric-arrow">Spectator &rarr; Tourist &rarr; Operator &rarr; <span class="accent">Architect</span></p>
      </div>
      <div class="brand-mark">Cultivated AI &middot; <span class="b-grow">For Owners</span></div>
      <div class="slide-num">02 &middot; The fluency rubric</div>
    </section>

    <!-- ═══ 03 · Story 01 · Tata Steel (lean hero) ═══ -->
    <section class="card-deck-card deck-slide slide-tata" data-slide="tata">
      <div class="tata-content stagger">
        <p class="tata-eyebrow">Story 01</p>
        <h1 class="tata-name">Tata Steel.</h1>
        <p class="tata-fact"><em>$2 billion saved.</em> <span class="dot">/</span> <em>Seven years.</em> <span class="dot">/</span> <em>Leadership-first.</em></p>
        <p class="tata-context">In 2018, Tata Steel had no public AI footprint. The board made AI a personal priority. <em>That one decision is what produced the numbers above.</em></p>
      </div>
      <div class="brand-mark">Cultivated AI &middot; <span class="b-grow">For Owners</span></div>
      <div class="slide-num">03 &middot; Story 01 · Tata Steel</div>
    </section>

    <!-- ═══ 04 · Story 02 · Two playbooks: Athena + CiNOC ═══ -->
    <section class="card-deck-card deck-slide slide-patterns" data-slide="patterns">
      <div class="patterns-content stagger">
        <p class="patterns-eyebrow">Story 02 &middot; Two playbooks closer to home</p>
        <h1 class="patterns-headline">One starts on the <em>shop floor</em>. One starts in the <em>boardroom</em>.</h1>
        <div class="patterns-grid">
          <div class="pattern-card athena">
            <p class="pc-tag">The shop-floor play</p>
            <h3 class="pc-name">JSW Athena.</h3>
            <p class="pc-title">Sensors plus ML on equipment you already own.</p>
            <div class="pc-stats">
              <div><span class="pc-num">13,500</span><span class="pc-label">smart sensors</span></div>
              <div><span class="pc-num">25,000+ hrs</span><span class="pc-label">downtime avoided FY25</span></div>
            </div>
          </div>
          <div class="pattern-card cinoc">
            <p class="pc-tag">The boardroom play</p>
            <h3 class="pc-name">Adani CiNOC.</h3>
            <p class="pc-title">A single AI command centre across the group.</p>
            <div class="pc-stats">
              <div><span class="pc-num">3 layers</span><span class="pc-label">plant · logistics · commercial</span></div>
              <div><span class="pc-num">1 room</span><span class="pc-label">running it all</span></div>
            </div>
          </div>
        </div>
        <p class="patterns-pull">Shop floor or boardroom. <em>Both demand an Architect at the top.</em></p>
