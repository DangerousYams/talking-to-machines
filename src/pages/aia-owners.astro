---
export const prerender = true;
import '../styles/global.css';

const slides = [
  'cover',
  'rubric',
  'tata',
  'patterns',
  'positioning',
  'licensing',
  'winners',
  'stages',
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Cultivated AI · For Owners · AIA Engineering</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&display=swap" />
  <style>
    /* ══════════════════════════════════════════════════════
       Cultivated AI · For Owners · AIA owner-fluency deck
       Inherits global tokens (cream / deep / accent / etc).
       Primary accent: navy. Stat callouts: accent-red. Action: amber.
       ══════════════════════════════════════════════════════ */
    body.card-deck-page { background: var(--color-cream); }

    .deck-slide {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 4rem 5rem;
      box-sizing: border-box;
    }

    /* ─── Progress rail ─── */
    .progress-rail {
      position: fixed; top: 20px; left: 50%; transform: translateX(-50%);
      display: flex; gap: 6px; z-index: 50; padding: 8px 14px;
      background: rgba(250, 248, 245, 0.75); backdrop-filter: blur(10px);
      border-radius: 100px; border: 1px solid rgba(26,26,46,0.05);
    }
    .progress-dot {
      width: 5px; height: 5px; border-radius: 50%;
      background: rgba(26,26,46,0.15); transition: all 0.3s ease;
    }
    .progress-dot.active { background: var(--color-navy); width: 16px; border-radius: 100px; }
    .progress-dot.visited { background: rgba(26,26,46,0.35); }

    /* ─── Brand mark + slide num ─── */
    .brand-mark {
      position: absolute; bottom: 24px; left: 32px;
      font-family: var(--font-mono); font-size: 0.72rem;
      letter-spacing: 0.08em; color: var(--color-subtle);
    }
    .brand-mark .b-grow { font-style: italic; color: var(--color-navy); }
    .slide-num {
      position: absolute; bottom: 24px; right: 32px;
      font-family: var(--font-mono); font-size: 0.7rem;
      letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-subtle);
    }

    /* ─── Keyboard hint ─── */
    .kbd-hint {
      position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%);
      z-index: 40; font-family: var(--font-mono); font-size: 0.72rem;
      color: var(--color-subtle); background: rgba(250, 248, 245, 0.85);
      backdrop-filter: blur(8px); padding: 6px 14px; border-radius: 100px;
      border: 1px solid rgba(26,26,46,0.06); transition: opacity 0.4s ease;
    }
    .kbd-hint.hidden { opacity: 0; pointer-events: none; }
    .kbd-hint kbd {
      font-family: var(--font-mono); font-size: 0.7rem; padding: 2px 6px;
      background: var(--color-warm-white); border: 1px solid rgba(26,26,46,0.15);
      border-radius: 4px; margin: 0 1px;
    }

    /* ─── Card-deck container ─── */
    .card-deck-container { scroll-snap-type: y mandatory; height: 100vh; overflow-y: scroll; }
    .card-deck-card {
      scroll-snap-align: start; min-height: 100vh; position: relative;
      opacity: 0.55; transition: opacity 0.5s ease;
    }
    .card-deck-card.is-active { opacity: 1; }

    /* ─── Stagger animation ─── */
    .stagger > * { opacity: 0; transform: translateY(14px); transition: opacity 0.5s ease, transform 0.5s ease; }
    .deck-slide.is-active .stagger > * { opacity: 1; transform: translateY(0); }
    .deck-slide.is-active .stagger > *:nth-child(1) { transition-delay: 0.1s; }
    .deck-slide.is-active .stagger > *:nth-child(2) { transition-delay: 0.2s; }
    .deck-slide.is-active .stagger > *:nth-child(3) { transition-delay: 0.3s; }
    .deck-slide.is-active .stagger > *:nth-child(4) { transition-delay: 0.4s; }
    .deck-slide.is-active .stagger > *:nth-child(5) { transition-delay: 0.5s; }
    .deck-slide.is-active .stagger > *:nth-child(6) { transition-delay: 0.6s; }

    /* ─── Print: 1600x900 per page ─── */
    @page { size: 1600px 900px; margin: 0; }
    @media print {
      html, body { background: var(--color-cream) !important; }
      .progress-rail, .kbd-hint { display: none !important; }
      .card-deck-container { scroll-snap-type: none; height: auto; overflow: visible; }
      .card-deck-card, .deck-slide {
        width: 1600px !important; height: 900px !important;
        min-height: 900px !important; max-height: 900px !important;
        page-break-after: always !important; break-after: page !important;
        opacity: 1 !important; padding: 4rem 5rem !important;
        box-sizing: border-box !important; overflow: hidden !important;
      }
      .card-deck-card:last-child, .deck-slide:last-child {
        page-break-after: auto !important; break-after: auto !important;
      }
      .stagger > * { opacity: 1 !important; transform: none !important; }
    }

    .deck-slide p { max-width: none; }

    /* ══════════════════════════════════════════════════════
       SLIDE 01 — Cover
       ══════════════════════════════════════════════════════ */
    .slide-cover { align-items: center; justify-content: center; text-align: center; }
    .cover-eyebrow {
      font-family: var(--font-mono); font-size: 0.85rem;
      letter-spacing: 0.28em; text-transform: uppercase;
      color: var(--color-subtle); margin: 0 0 2rem;
    }
    .cover-eyebrow .dot { color: var(--color-navy); }
    .wordmark {
      font-family: var(--font-heading); font-weight: 800;
      font-size: clamp(4.5rem, 11vw, 9rem); line-height: 1;
      color: var(--color-deep); letter-spacing: -0.03em; margin: 0 0 1.25rem;
    }
    .wordmark .ai { font-style: italic; color: var(--color-navy); }
    .verb-pair {
      font-family: var(--font-heading);
      font-size: clamp(1.8rem, 3.2vw, 2.6rem);
      font-weight: 400; font-style: italic;
      color: var(--color-deep); margin: 0 0 1.75rem; letter-spacing: -0.01em;
    }
    .verb-pair .grow { color: var(--color-navy); font-weight: 700; font-style: normal; }
    .verb-pair .chase { color: var(--color-accent-red); font-weight: 700; font-style: normal; text-decoration: line-through; text-decoration-thickness: 2px; }
    .cover-context {
      font-family: var(--font-mono); font-size: 0.85rem;
      letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--color-subtle); margin: 1.25rem 0 0;
    }
    .cover-context .pipe { color: rgba(15,52,96,0.5); margin: 0 0.6rem; }

    /* ══════════════════════════════════════════════════════
       SLIDE 02 — Tata Steel (story 01) · lean hero
       ══════════════════════════════════════════════════════ */
    .slide-tata {
      padding: 4rem 5rem;
      align-items: center; justify-content: center;
    }
    .tata-content {
      max-width: 1300px; margin: 0 auto; width: 100%;
      text-align: center;
    }
    .tata-eyebrow {
      font-family: var(--font-mono); font-size: 0.82rem;
      letter-spacing: 0.28em; text-transform: uppercase;
      color: var(--color-accent-red); margin: 0 0 1.8rem;
    }
    .tata-name {
      font-family: var(--font-heading); font-weight: 800;
      font-size: clamp(5rem, 9vw, 7.5rem); line-height: 0.95;
      color: var(--color-deep); letter-spacing: -0.04em;
      margin: 0 0 2.4rem;
    }
    .tata-fact {
      font-family: var(--font-heading);
      font-size: clamp(1.9rem, 3.4vw, 2.7rem);
      font-weight: 700;
      color: var(--color-deep); letter-spacing: -0.015em;
      margin: 0 0 2.4rem; line-height: 1.2;
    }
    .tata-fact em {
      font-style: italic; color: var(--color-navy); font-weight: 800;
    }
    .tata-fact .dot {
      color: var(--color-subtle); margin: 0 0.7rem;
      opacity: 0.4; font-weight: 400; font-style: normal;
    }
    .tata-context {
      font-family: var(--font-body);
      font-size: 1.1rem; color: var(--color-subtle);
      max-width: 820px; margin: 0 auto 2.4rem; line-height: 1.55;
    }
    .tata-context em { font-style: italic; color: var(--color-deep); font-weight: 600; }
    .tata-pull {
      font-family: var(--font-heading); font-style: italic;
      font-size: 1.35rem; color: var(--color-deep); margin: 0 auto;
      letter-spacing: -0.005em; line-height: 1.4;
      padding: 1.2rem 2rem;
      background: rgba(15,52,96,0.05); border-radius: 4px;
      max-width: 1100px;
    }
    .tata-pull em { font-style: italic; color: var(--color-accent-red); font-weight: 700; }

    /* ══════════════════════════════════════════════════════
       SLIDE 03 — Two playbooks: Athena + CiNOC (story 02) · lean
       ══════════════════════════════════════════════════════ */
    .slide-patterns { padding: 3.5rem 5rem; }
    .patterns-content { max-width: 1450px; margin: 0 auto; width: 100%; }
    .patterns-eyebrow {
      font-family: var(--font-mono); font-size: 0.78rem;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--color-accent-red); margin: 0 0 0.85rem;
    }
    .patterns-headline {
      font-family: var(--font-heading); font-weight: 800;
      font-size: clamp(2rem, 3.4vw, 2.8rem); line-height: 1.08;
      color: var(--color-deep); letter-spacing: -0.02em; margin: 0 0 1.6rem;
    }
    .patterns-headline em { font-style: italic; color: var(--color-navy); font-weight: 800; }
    .patterns-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 1.8rem;
    }
    .pattern-card {
      padding: 1.8rem 1.9rem; background: var(--color-warm-white);
      border-top: 4px solid var(--color-navy); border-radius: 4px;
      box-shadow: 0 2px 14px rgba(26,26,46,0.05);
      display: flex; flex-direction: column;
    }
    .pattern-card.athena { border-top-color: var(--color-amber); }
    .pattern-card .pc-tag {
      font-family: var(--font-mono); font-size: 0.72rem;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--color-navy); margin: 0 0 0.5rem;
    }
    .pattern-card.athena .pc-tag { color: var(--color-amber); }
    .pattern-card .pc-name {
      font-family: var(--font-heading); font-weight: 800;
      font-size: clamp(2.2rem, 3.4vw, 3rem);
      line-height: 0.95; letter-spacing: -0.03em;
      color: var(--color-deep); margin: 0 0 0.5rem;
    }
    .pattern-card .pc-title {
      font-family: var(--font-body); font-style: italic;
      font-size: 1.05rem; color: var(--color-subtle);
      margin: 0 0 1.3rem; line-height: 1.45;
    }
    .pattern-card .pc-stats {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem;
      margin: 0 0 1.4rem;
      padding: 1rem 0; border-top: 1px solid rgba(26,26,46,0.08);
      border-bottom: 1px solid rgba(26,26,46,0.08);
    }
    .pattern-card .pc-stats > div { display: flex; flex-direction: column; gap: 0.25rem; }
    .pattern-card .pc-num {
      font-family: var(--font-heading); font-weight: 800;
      font-size: 1.7rem; color: var(--color-navy); line-height: 1;
      letter-spacing: -0.015em;
    }
    .pattern-card.athena .pc-num { color: var(--color-amber); }
    .pattern-card .pc-label {
      font-family: var(--font-mono); font-size: 0.66rem;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--color-subtle);
    }
    .pattern-card .pc-aia {
      font-family: var(--font-body); font-size: 0.95rem;
      line-height: 1.5; color: var(--color-deep); margin: 0;
      padding: 1rem 1.2rem;
      background: rgba(15,52,96,0.05); border-radius: 4px;
    }
    .pattern-card.athena .pc-aia { background: rgba(245,166,35,0.08); }
    .pattern-card .pc-aia strong {
      font-family: var(--font-mono); font-weight: 700;
      font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--color-navy); display: block; margin-bottom: 0.35rem;
    }
    .pattern-card.athena .pc-aia strong { color: var(--color-amber); }
    .pattern-card .pc-aia em { font-style: italic; color: var(--color-deep); font-weight: 600; }
    .patterns-pull {
      font-family: var(--font-heading); font-style: italic;
      font-size: 1.4rem; color: var(--color-deep); margin: 1.6rem 0 0;
      text-align: center; letter-spacing: -0.005em; line-height: 1.35;
    }
    .patterns-pull em { font-style: italic; font-weight: 700; color: var(--color-accent-red); }

    /* ══════════════════════════════════════════════════════
       SLIDE 04 — BCG · the 12× rule (story 03)
       ══════════════════════════════════════════════════════ */
    .slide-bcg { padding: 3.5rem 5rem; }
    .bcg-content { max-width: 1400px; margin: 0 auto; width: 100%; }
    .bcg-eyebrow {
      font-family: var(--font-mono); font-size: 0.78rem;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--color-accent-red); margin: 0 0 0.85rem;
    }
    .bcg-headline {
      font-family: var(--font-heading); font-weight: 800;
      font-size: clamp(2rem, 3.4vw, 2.8rem); line-height: 1.08;
      color: var(--color-deep); letter-spacing: -0.02em; margin: 0 0 1.6rem;
    }
    .bcg-headline em { font-style: italic; color: var(--color-navy); font-weight: 800; }
    .bcg-twin {
      display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 2.4rem;
      align-items: center; margin-bottom: 1.4rem;
    }
    .bcg-left { text-align: center; padding: 1.4rem 1rem; }
    .bcg-num {
      font-family: var(--font-heading); font-weight: 800;
      font-size: clamp(7rem, 13vw, 11rem); line-height: 0.95;
      color: var(--color-amber); margin: 0 0 0.4rem;
      letter-spacing: -0.05em;
    }
    .bcg-num .bcg-x { font-style: italic; }
    .bcg-label {
      font-family: var(--font-heading); font-style: italic;
      font-size: 1.25rem; color: var(--color-deep);
      margin: 0 0 0.4rem; line-height: 1.2;
    }
    .bcg-quote {
      font-family: var(--font-heading); font-style: italic;
      font-weight: 700;
      font-size: clamp(2.2rem, 4vw, 3.1rem);
      line-height: 1.12; letter-spacing: -0.015em;
      color: var(--color-deep); margin: 0 0 1.1rem;
    }
    .bcg-quote em {
      font-style: italic; font-weight: 800;
      color: var(--color-amber);
    }
    .bcg-source {
      font-family: var(--font-mono); font-size: 0.72rem;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--color-subtle); margin: 0;
    }
    .bcg-explain {
      font-family: var(--font-body); font-size: 1.1rem;
      line-height: 1.55; color: var(--color-deep);
      margin: 0 0 1.1rem;
    }
    .bcg-explain em { font-style: italic; color: var(--color-navy); font-weight: 600; }
    .bcg-points {
      list-style: none; padding: 0; margin: 0;
      font-family: var(--font-body); font-size: 0.93rem;
      line-height: 1.5; color: var(--color-deep);
    }
    .bcg-points li {
      padding: 0.45rem 0 0.45rem 1.1rem; position: relative;
      border-top: 1px solid rgba(26,26,46,0.08);
    }
    .bcg-points li:first-child { border-top: none; }
    .bcg-points li:before {
      content: ""; position: absolute; left: 0; top: 1.1rem;
      width: 7px; height: 1px; background: var(--color-amber); opacity: 0.7;
    }
    .bcg-points li strong {
      font-weight: 700; color: var(--color-navy);
      font-family: var(--font-heading); font-size: 1rem;
    }
    .bcg-pull {
      font-family: var(--font-heading); font-style: italic;
      font-size: 1.25rem; color: var(--color-deep); margin: 0;
      text-align: center; letter-spacing: -0.005em;
      padding: 1rem 1.5rem;
      background: rgba(245,166,35,0.08); border-radius: 4px;
    }
    .bcg-pull em { font-style: italic; color: var(--color-accent-red); font-weight: 700; }

    /* ══════════════════════════════════════════════════════
       SLIDE 05 — Your immediate world (3 cards: 2 competitors + 1 customer)
       ══════════════════════════════════════════════════════ */
    .slide-world { padding: 3.5rem 5rem; }
    .world-content { max-width: 1450px; margin: 0 auto; width: 100%; }
    .world-eyebrow {
      font-family: var(--font-mono); font-size: 0.78rem;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--color-accent-red); margin: 0 0 0.85rem;
    }
    .world-headline {
      font-family: var(--font-heading); font-weight: 800;
      font-size: clamp(2.2rem, 3.8vw, 3.2rem); line-height: 1.05;
      color: var(--color-deep); letter-spacing: -0.02em; margin: 0 0 0.5rem;
    }
    .world-headline em { font-style: italic; color: var(--color-navy); font-weight: 800; }
    .world-sub {
      font-family: var(--font-body); font-size: 1.05rem;
      color: var(--color-subtle); margin: 0 0 1.8rem; max-width: 1150px;
      line-height: 1.55;
    }
    .world-sub em { font-style: italic; color: var(--color-deep); font-weight: 600; }
    .world-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;
    }
    .world-card {
      background: var(--color-warm-white);
      border-top: 4px solid var(--color-navy);
      border-radius: 4px;
      padding: 1.5rem 1.6rem;
      box-shadow: 0 2px 14px rgba(26,26,46,0.05);
      display: flex; flex-direction: column;
    }
    .world-card.customer { border-top-color: var(--color-accent-red); }
    .world-card .wc-tag {
      font-family: var(--font-mono); font-size: 0.72rem;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--color-navy); margin: 0 0 0.4rem;
    }
    .world-card.customer .wc-tag { color: var(--color-accent-red); }
    .world-card .wc-name {
      font-family: var(--font-heading); font-weight: 800;
      font-size: 1.7rem; color: var(--color-deep);
      margin: 0 0 0.2rem; letter-spacing: -0.01em; line-height: 1.1;
    }
    .world-card .wc-where {
      font-family: var(--font-body); font-style: italic;
      font-size: 0.85rem; color: var(--color-subtle); margin: 0 0 1rem;
    }
    .world-card .wc-fact {
      font-family: var(--font-body); font-size: 0.95rem;
      line-height: 1.55; color: var(--color-deep); margin: 0 0 1rem;
      flex-grow: 1;
    }
    .world-card .wc-fact em { font-style: italic; color: var(--color-navy); font-weight: 600; }
    .world-card.customer .wc-fact em { color: var(--color-accent-red); }
    .world-card .wc-source {
      display: block; font-family: var(--font-mono); font-size: 0.66rem;
      letter-spacing: 0.06em; color: var(--color-subtle); margin-top: 0.45rem;
    }
    .world-card .wc-aia {
      font-family: var(--font-body); font-size: 0.92rem;
      line-height: 1.5; color: var(--color-deep); margin: 0;
      padding: 0.85rem 1rem;
      background: rgba(15,52,96,0.05); border-radius: 4px;
    }
    .world-card.customer .wc-aia { background: rgba(233,69,96,0.06); }
    .world-card .wc-aia strong {
      font-family: var(--font-mono); font-weight: 700;
      font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--color-navy); display: block; margin-bottom: 0.3rem;
    }
    .world-card.customer .wc-aia strong { color: var(--color-accent-red); }
    .world-card .wc-aia em { font-style: italic; color: var(--color-deep); font-weight: 600; }
    .world-pull {
      font-family: var(--font-heading); font-style: italic;
      font-size: 1.2rem; color: var(--color-deep); margin: 1.6rem 0 0;
      text-align: center; letter-spacing: -0.005em;
    }
    .world-pull em { font-style: italic; color: var(--color-accent-red); font-weight: 700; }

    /* ══════════════════════════════════════════════════════
       SLIDE 04 — Where AI lands first (function grid)
       ══════════════════════════════════════════════════════ */
    .slide-functions { padding: 3.2rem 5rem; }
    .fn-content { max-width: 1450px; margin: 0 auto; width: 100%; }
    .fn-eyebrow {
      font-family: var(--font-mono); font-size: 0.78rem;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--color-navy); margin: 0 0 0.85rem;
    }
    .fn-headline {
      font-family: var(--font-heading); font-weight: 800;
      font-size: clamp(2.2rem, 3.6vw, 3rem); line-height: 1.05;
      color: var(--color-deep); letter-spacing: -0.02em; margin: 0 0 0.5rem;
    }
    .fn-headline em { font-style: italic; color: var(--color-navy); font-weight: 800; }
    .fn-sub {
      font-family: var(--font-body); font-size: 1rem;
      color: var(--color-subtle); margin: 0 0 1.7rem; max-width: 1000px;
    }
    .fn-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem 1.3rem;
    }
    .fn-card {
      padding: 1.2rem 1.3rem; background: var(--color-warm-white);
      border-top: 3px solid var(--color-navy); border-radius: 4px;
      box-shadow: 0 2px 12px rgba(26,26,46,0.04);
    }
    .fn-card .fn-name {
      font-family: var(--font-mono); font-size: 0.7rem;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--color-navy); margin: 0 0 0.4rem;
    }
    .fn-card .fn-shift {
      font-family: var(--font-heading); font-weight: 700;
      font-style: italic; font-size: 1.08rem; color: var(--color-deep);
