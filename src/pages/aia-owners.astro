    }
    .fn-card ul {
      list-style: none; padding: 0; margin: 0;
      font-family: var(--font-body); font-size: 0.88rem;
      line-height: 1.45; color: var(--color-deep);
    }
    .fn-card ul li {
      padding: 0.32rem 0 0.32rem 0.9rem; position: relative;
    }
    .fn-card ul li:before {
      content: ""; position: absolute; left: 0; top: 0.85rem;
      width: 5px; height: 1px; background: var(--color-navy); opacity: 0.5;
    }
    .fn-card ul li em { font-style: italic; color: var(--color-navy); font-weight: 600; }

    /* ══════════════════════════════════════════════════════
       SLIDE 07 — The fluency rubric (Spectator → Architect)
       ══════════════════════════════════════════════════════ */
    .slide-rubric { padding: 3.5rem 5rem; justify-content: center; }
    .rubric-content { max-width: 1450px; margin: 0 auto; width: 100%; }
    .rubric-eyebrow {
      font-family: var(--font-mono); font-size: 0.78rem;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--color-amber); margin: 0 0 0.85rem;
    }
    .rubric-headline {
      font-family: var(--font-heading); font-weight: 800;
      font-size: clamp(2.6rem, 4.2vw, 3.6rem); line-height: 1.05;
