    .rubric-sub em { font-style: italic; color: var(--color-deep); font-weight: 600; }
    .rubric-grid {
      list-style: none; padding: 0; margin: 0 0 1.4rem;
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.3rem;
    }
    .rubric-rung {
      padding: 1.5rem 1.4rem;
      background: var(--color-warm-white);
      border-top: 4px solid var(--color-navy);
      border-radius: 4px;
      box-shadow: 0 2px 14px rgba(26,26,46,0.04);
    }
    .rubric-rung.r1 { border-top-color: rgba(107,114,128,0.7); }
    .rubric-rung.r2 { border-top-color: var(--color-accent-red); }
    .rubric-rung.r3 { border-top-color: var(--color-amber); }
    .rubric-rung.r4 {
      border-top-color: var(--color-navy);
      box-shadow: 0 4px 22px rgba(15,52,96,0.15);
      background: rgba(15,52,96,0.04);
    }
    .rubric-num {
      font-family: var(--font-mono); font-size: 0.7rem;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--color-subtle); margin: 0 0 0.35rem;
    }
    .rubric-rung.r4 .rubric-num { color: var(--color-navy); }
    .rubric-name {
      font-family: var(--font-heading); font-weight: 800;
      font-size: 1.6rem; color: var(--color-deep);
      margin: 0 0 0.7rem; letter-spacing: -0.01em; line-height: 1.05;
    }
    .rubric-rung.r1 .rubric-name { color: var(--color-subtle); }
    .rubric-rung.r2 .rubric-name { color: var(--color-accent-red); }
    .rubric-rung.r3 .rubric-name { color: var(--color-amber); }
    .rubric-rung.r4 .rubric-name { color: var(--color-navy); }
    .rubric-line {
      font-family: var(--font-body); font-size: 0.92rem;
      line-height: 1.5; color: var(--color-deep); margin: 0;
    }
    .rubric-arrow {
      font-family: var(--font-mono); font-size: 0.85rem;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--color-subtle); margin: 0; text-align: center;
    }
    .rubric-arrow .accent { color: var(--color-navy); font-weight: 700; }

    /* ══════════════════════════════════════════════════════
       SLIDE 05 — Positioning (imported from cultivated-ai)
       ══════════════════════════════════════════════════════ */
    .slide-positioning { justify-content: center; }
    .positioning-content { max-width: 900px; margin: 0 auto; width: 100%; }
    .positioning-statement {
      font-family: var(--font-heading); font-weight: 700;
      font-size: clamp(2.4rem, 4.4vw, 3.55rem);
