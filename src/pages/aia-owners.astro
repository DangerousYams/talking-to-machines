    }
    .rubric-headline em { font-style: italic; color: var(--color-navy); font-weight: 800; }
    .rubric-sub {
      font-family: var(--font-body); font-size: 1rem;
      color: var(--color-subtle); margin: 0 0 1.6rem; max-width: 1150px;
