      margin: 0; color: var(--color-deep);
    }
    .positioning-statement .p-who { color: var(--color-teal); }
    .positioning-statement .p-what { color: var(--color-amber); }
    .positioning-statement .p-against { color: var(--color-accent-red); }

    /* ══════════════════════════════════════════════════════
       SLIDE 06 — Licensing isn't adoption (imported)
       ══════════════════════════════════════════════════════ */
    .slide-licensing { justify-content: center; }
    .licensing-content { max-width: 1000px; margin: 0 auto; width: 100%; }
    .licensing-title {
      font-family: var(--font-heading); font-weight: 800;
      font-size: clamp(3.5rem, 7vw, 6rem);
      letter-spacing: -0.04em; line-height: 1;
      margin: 0 0 2.5rem; color: var(--color-deep);
    }
    .licensing-title .strike {
      text-decoration: line-through;
      text-decoration-color: rgba(233,69,96,0.65);
      text-decoration-thickness: 4px;
      color: var(--color-accent-red);
    }
    .licensing-beats {
      list-style: none; padding: 0; margin: 0;
      display: flex; flex-direction: column; gap: 1rem;
    }
    .licensing-beats li {
      font-family: var(--font-body); font-size: 1.4rem;
      line-height: 1.5; color: var(--color-deep);
      padding-left: 1.6rem; position: relative;
    }
    .licensing-beats li::before {
      content: ''; position: absolute; left: 0; top: 0.85rem;
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--color-amber);
    }
    .licensing-beats em { color: var(--color-navy); font-style: italic; font-weight: 600; }

    /* ══════════════════════════════════════════════════════
       SLIDE 07 — What the winners did (imported)
       ══════════════════════════════════════════════════════ */
    .slide-winners { justify-content: center; }
    .winners-content { max-width: 1200px; margin: 0 auto; width: 100%; }
    .winners-headline {
      font-family: var(--font-heading); font-weight: 800;
      font-size: clamp(2.5rem, 5vw, 4rem);
      letter-spacing: -0.03em; line-height: 1.05;
