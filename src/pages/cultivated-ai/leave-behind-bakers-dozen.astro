---
export const prerender = true;
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Cultivated AI · Leave-behind · The Baker's Dozen</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&display=swap" />
  <style>
    /* ══════════════════════════════════════════════════════
       Cultivated AI · Leave-behind
       A4 portrait. 3 pages. Designed for print → PDF.
       Open this URL, then ⌘P (or Ctrl+P), Save as PDF.
       ══════════════════════════════════════════════════════ */

    html, body {
      margin: 0;
      padding: 0;
      background: #E5E2DC;
      color: var(--color-deep);
      font-family: var(--font-body);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    body::before { display: none !important; }

    .lb-shell {
      max-width: 210mm;
      margin: 0 auto;
      padding: 2rem 0;
    }

    .lb-page {
      width: 210mm;
      min-height: 297mm;
      background: var(--color-cream);
      box-shadow: 0 10px 40px rgba(15,52,96,0.12);
      margin: 0 auto 2rem;
      padding: 20mm 18mm;
      box-sizing: border-box;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    /* Content centres vertically; footer sits at the foot. Whitespace
       becomes balanced breathing room rather than a gap at the bottom. */
    .lb-pagebody {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 0;
    }

    .lb-page:last-child { margin-bottom: 0; }

    /* Footer band on every page */
    .lb-footer {
      margin-top: 1.75rem;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-subtle);
      border-top: 1px solid rgba(26,26,46,0.08);
      padding-top: 6mm;
    }
    .lb-footer .brand { color: var(--color-deep); font-weight: 700; }
    .lb-footer .brand em { color: var(--color-amber); font-style: italic; font-weight: 600; letter-spacing: 0.05em; }
    .lb-footer .num { color: var(--color-subtle); }

    /* ─── Print rules ─── */
    @media print {
      @page {
        size: A4 portrait;
        margin: 0;
      }
      html, body {
        background: var(--color-cream) !important;
      }
      .lb-shell { padding: 0; max-width: none; }
      .lb-page {
        margin: 0 !important;
        box-shadow: none !important;
        page-break-after: always;
        break-after: page;
        width: 210mm !important;
        height: 297mm !important;
        min-height: 297mm !important;
      }
      .lb-page:last-child {
        page-break-after: auto;
        break-after: auto;
      }
      .screen-only { display: none !important; }
    }

    /* Print hint banner (hidden when printing) */
    .print-hint {
      max-width: 210mm;
      margin: 0 auto 1.5rem;
      padding: 0.85rem 1.25rem;
      background: var(--color-warm-white);
      border: 1px solid rgba(245,166,35,0.35);
      border-radius: 8px;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--color-navy);
    }
    .print-hint kbd {
      background: rgba(15,52,96,0.08);
      padding: 1px 6px;
      border-radius: 3px;
      font-size: 0.78rem;
    }
    .print-hint .accent { color: var(--color-amber); font-weight: 700; }

    /* ════════════════════════════════════════════════════
       PAGE 1 · Cover · the discipline · three stages
       ════════════════════════════════════════════════════ */
    .lb-cover-eyebrow {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--color-amber);
      margin: 0 0 1rem;
    }
    .lb-wordmark {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 4.5rem;
      line-height: 1;
      letter-spacing: -0.03em;
      margin: 0;
      color: var(--color-deep);
    }
    .lb-wordmark .ai { color: var(--color-amber); font-style: italic; }
    .lb-verb {
      font-family: var(--font-heading);
      font-weight: 700;
      font-style: italic;
      font-size: 1.7rem;
      color: var(--color-deep);
      margin: 1rem 0 0;
    }
    .lb-verb .grow { color: var(--color-teal); }
    .lb-verb .chase { color: var(--color-accent-red); text-decoration: line-through; text-decoration-thickness: 2px; text-decoration-color: rgba(233,69,96,0.5); }

    .lb-pitch {
      margin: 2.5rem 0 0;
      padding: 1.5rem 1.75rem;
      background: var(--color-warm-white);
      border-left: 4px solid var(--color-amber);
      border-radius: 0 10px 10px 0;
    }
    .lb-pitch p {
      font-family: var(--font-body);
      font-size: 1.02rem;
      line-height: 1.55;
      color: var(--color-deep);
      margin: 0;
    }
    .lb-pitch em { color: var(--color-navy); font-style: italic; font-weight: 600; }

    .lb-section-label {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--color-subtle);
      margin: 2rem 0 0.85rem;
    }
    .lb-section-label .accent { color: var(--color-amber); }

    .lb-stages-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }
    .lb-stage-row {
      display: flex;
      gap: 1rem;
      padding: 0.75rem 1rem;
      background: var(--color-warm-white);
      border-radius: 8px;
      border: 1px solid rgba(26,26,46,0.06);
      align-items: baseline;
      position: relative;
      overflow: hidden;
    }
    .lb-stage-row::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 4px;
    }
    .lb-stage-row.s1::before { background: var(--color-amber); }
    .lb-stage-row.s2::before { background: var(--color-teal); }
    .lb-stage-row.s3::before { background: var(--color-purple); }
    .lb-stage-row.s4::before { background: var(--color-accent-red); }
    .lb-stage-num {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      width: 56px;
      flex-shrink: 0;
    }
    .lb-stage-row.s1 .lb-stage-num { color: var(--color-amber); }
    .lb-stage-row.s2 .lb-stage-num { color: var(--color-teal); }
    .lb-stage-row.s3 .lb-stage-num { color: var(--color-purple); }
    .lb-stage-row.s4 .lb-stage-num { color: var(--color-accent-red); }
    .lb-stage-name {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.05rem;
      letter-spacing: -0.01em;
      color: var(--color-deep);
      width: 130px;
      flex-shrink: 0;
    }
    .lb-stage-row.s1 .lb-stage-name { color: var(--color-amber); }
    .lb-stage-row.s2 .lb-stage-name { color: var(--color-teal); }
    .lb-stage-row.s3 .lb-stage-name { color: var(--color-purple); }
    .lb-stage-row.s4 .lb-stage-name { color: var(--color-accent-red); }
    .lb-stage-tag {
      font-family: var(--font-body);
      font-size: 0.95rem;
      line-height: 1.45;
      color: var(--color-deep);
      flex: 1;
    }
    .lb-stage-tag em { color: var(--color-navy); font-style: italic; }

    .lb-grouping {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-subtle);
      margin: 0.85rem 0 0;
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .lb-grouping .programme { color: var(--color-amber); font-weight: 700; }
    .lb-grouping .grad { color: var(--color-navy); font-weight: 700; }

    /* ════════════════════════════════════════════════════
       PAGE 2 · The four days · the ladder
       ════════════════════════════════════════════════════ */
    .lb-page-title {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 2.6rem;
      letter-spacing: -0.03em;
      line-height: 1.05;
      margin: 0 0 1rem;
      color: var(--color-deep);
    }
    .lb-page-title em { color: var(--color-amber); font-style: italic; }
    .lb-page-sub {
      font-family: var(--font-body);
      font-style: italic;
      font-size: 1rem;
      color: var(--color-subtle);
      margin: 0 0 2rem;
    }

    .lb-spec-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.65rem 1.5rem;
      margin: 0 0 1.5rem;
    }
    .lb-spec-row {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      padding: 0.55rem 0;
      border-bottom: 1px solid rgba(26,26,46,0.07);
    }
    .lb-spec-key {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-amber);
    }
    .lb-spec-val {
      font-family: var(--font-body);
      font-size: 0.98rem;
      line-height: 1.4;
      color: var(--color-deep);
    }
    .lb-spec-val em { color: var(--color-navy); font-style: italic; }

    .lb-price-block {
      margin: 1.25rem 0 1.5rem;
      padding: 1.25rem 1.5rem;
      background: var(--color-warm-white);
      border-radius: 10px;
      border-left: 4px solid var(--color-amber);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }
    .lb-price-mega {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 2.6rem;
      letter-spacing: -0.03em;
      line-height: 1;
      color: var(--color-deep);
      margin: 0;
    }
    .lb-price-mega .ru { color: var(--color-amber); }
    .lb-price-tag {
      font-family: var(--font-body);
      font-style: italic;
      font-size: 0.95rem;
      color: var(--color-subtle);
      margin: 0.3rem 0 0;
    }
    .lb-price-explain {
      font-family: var(--font-body);
      font-size: 0.92rem;
      line-height: 1.5;
      color: var(--color-deep);
      margin: 0;
      max-width: 35ch;
    }
    .lb-price-explain em { color: var(--color-navy); font-style: italic; }

    .lb-bundle-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin: 0 0 1.5rem;
    }
    .lb-bundle-card {
      padding: 1rem 1.15rem;
      background: var(--color-warm-white);
      border-radius: 8px;
      border: 1px solid rgba(26,26,46,0.07);
      position: relative;
      overflow: hidden;
    }
    .lb-bundle-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
    }
    .lb-bundle-card.one::before { background: var(--color-teal); }
    .lb-bundle-card.two::before { background: var(--color-amber); }
    .lb-bundle-card .lb-bundle-num {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.3rem;
      opacity: 0.4;
      margin: 0 0 0.2rem;
    }
    .lb-bundle-card.one .lb-bundle-num { color: var(--color-teal); }
    .lb-bundle-card.two .lb-bundle-num { color: var(--color-amber); }
    .lb-bundle-card h3 {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.05rem;
      letter-spacing: -0.01em;
      margin: 0 0 0.5rem;
    }
    .lb-bundle-card.one h3 { color: var(--color-teal); }
    .lb-bundle-card.two h3 { color: var(--color-amber); }
    .lb-bundle-card p {
      font-family: var(--font-body);
      font-size: 0.85rem;
      line-height: 1.45;
      color: var(--color-deep);
      margin: 0;
    }
    .lb-bundle-card p em { color: var(--color-navy); font-style: italic; }

    /* (after-grid / optional-engagements styles removed: the 8-hour workshop has no graduation tier) */

    /* ════════════════════════════════════════════════════
       PAGE 3 · Takeaways · CTA
       ════════════════════════════════════════════════════ */
    .lb-examples-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin: 0 0 1.5rem;
    }
    .lb-example-card {
      padding: 1.05rem 1.2rem;
      background: var(--color-warm-white);
      border-radius: 10px;
      border: 1px solid rgba(26,26,46,0.07);
      position: relative;
      overflow: hidden;
    }
    .lb-example-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
    }
    .lb-example-card.bajaj::before { background: var(--color-teal); }
    .lb-example-card.nbim::before { background: var(--color-navy); }
    .lb-example-card .ex-stage {
      font-family: var(--font-mono);
      font-size: 0.6rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      margin-bottom: 0.3rem;
    }
    .lb-example-card.bajaj .ex-stage { color: var(--color-teal); }
    .lb-example-card.nbim .ex-stage { color: var(--color-navy); }
    .lb-example-card h3 {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.2rem;
      letter-spacing: -0.02em;
      margin: 0 0 0.5rem;
      color: var(--color-deep);
    }
    .lb-example-card .ex-numbers {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.05rem;
      line-height: 1.2;
      letter-spacing: -0.01em;
      margin: 0 0 0.5rem;
    }
    .lb-example-card.bajaj .ex-numbers { color: var(--color-teal); }
    .lb-example-card.nbim .ex-numbers { color: var(--color-navy); }
    .lb-example-card p {
      font-family: var(--font-body);
      font-size: 0.82rem;
      line-height: 1.5;
      color: var(--color-deep);
      margin: 0;
    }
    .lb-example-card p em { color: var(--color-navy); font-style: italic; }
    .lb-example-card .ex-quote {
      font-family: var(--font-heading);
      font-style: italic;
      font-size: 0.88rem;
      line-height: 1.4;
      color: var(--color-deep);
      margin: 0.5rem 0 0.3rem;
    }
    .lb-example-card .ex-attr {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.08em;
      color: var(--color-subtle);
    }

    .lb-failure-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.85rem;
      margin: 0 0 1.5rem;
    }
    .lb-failure-card {
      padding: 0.85rem 1.05rem;
      background: var(--color-warm-white);
      border-radius: 8px;
      border: 1px solid rgba(26,26,46,0.07);
      position: relative;
      overflow: hidden;
    }
    .lb-failure-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
    }
    .lb-failure-card.under::before { background: var(--color-sky); }
    .lb-failure-card.over::before { background: var(--color-accent-red); }
    .lb-failure-card .f-mode {
      font-family: var(--font-mono);
      font-size: 0.6rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      margin-bottom: 0.3rem;
    }
    .lb-failure-card.under .f-mode { color: var(--color-sky); }
    .lb-failure-card.over .f-mode { color: var(--color-accent-red); }
    .lb-failure-card h3 {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 0.98rem;
      margin: 0 0 0.35rem;
      color: var(--color-deep);
    }
    .lb-failure-card p {
      font-family: var(--font-body);
      font-size: 0.78rem;
      line-height: 1.45;
      color: var(--color-deep);
      margin: 0;
    }
    .lb-failure-card p em { color: var(--color-navy); font-style: italic; }

    .lb-founder {
      padding: 1.25rem 1.5rem;
      background: var(--color-warm-white);
      border-left: 4px solid var(--color-amber);
      border-radius: 0 10px 10px 0;
      margin: 0 0 1.25rem;
    }
    .lb-founder p {
      font-family: var(--font-body);
      font-size: 0.92rem;
      line-height: 1.5;
      color: var(--color-deep);
      margin: 0;
    }
    .lb-founder p strong { font-weight: 700; color: var(--color-navy); }
    .lb-founder p em { color: var(--color-amber); font-style: italic; font-weight: 600; }

    .lb-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 0.5rem;
      margin: 0 0 1.5rem;
    }
    .lb-badge {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 100px;
      border: 1px solid;
      background: var(--color-warm-white);
      letter-spacing: 0.04em;
    }
    .lb-badge.b1 { color: var(--color-accent-red); border-color: rgba(233,69,96,0.3); }
    .lb-badge.b2 { color: var(--color-purple); border-color: rgba(123,97,255,0.3); }
    .lb-badge.b3 { color: var(--color-teal); border-color: rgba(22,199,154,0.3); }
    .lb-badge.b4 { color: var(--color-amber); border-color: rgba(245,166,35,0.4); }
    .lb-badge.b5 { color: var(--color-sky); border-color: rgba(14,165,233,0.3); }
    .lb-badge.b6 { color: var(--color-navy); border-color: rgba(15,52,96,0.3); }

    .lb-cta {
      padding: 1.25rem 1.5rem;
      background: var(--color-deep);
      color: var(--color-cream);
      border-radius: 10px;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .lb-cta .cta-line {
      font-family: var(--font-heading);
      font-weight: 800;
      font-style: italic;
      font-size: 1.4rem;
      letter-spacing: -0.01em;
      margin: 0;
    }
    .lb-cta .cta-line .grow { color: var(--color-teal); }
    .lb-cta .cta-line .chase { color: var(--color-accent-red); text-decoration: line-through; text-decoration-thickness: 2px; text-decoration-color: rgba(233,69,96,0.6); }
    .lb-cta .cta-step {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(248,246,243,0.65);
    }
    .lb-cta .cta-email {
      font-family: var(--font-mono);
      font-size: 0.95rem;
      color: var(--color-amber);
      font-weight: 600;
    }

    /* ════════════════════════════════════════════════════
       Takeaways list — what each leader walks out with
       ════════════════════════════════════════════════════ */
    .lb-take-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .lb-take {
      display: flex;
      gap: 0.9rem;
      align-items: baseline;
      padding: 0.7rem 1rem;
      background: var(--color-warm-white);
      border-radius: 8px;
      border: 1px solid rgba(26,26,46,0.06);
      position: relative;
      overflow: hidden;
    }
    .lb-take::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 4px;
    }
    .lb-take.t1::before { background: var(--color-amber); }
    .lb-take.t2::before { background: var(--color-teal); }
    .lb-take.t3::before { background: var(--color-purple); }
    .lb-take.t4::before { background: var(--color-sky); }
    .lb-take.t5::before { background: var(--color-accent-red); }
    .lb-take-num {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      width: 22px;
      flex-shrink: 0;
    }
    .lb-take.t1 .lb-take-num { color: var(--color-amber); }
    .lb-take.t2 .lb-take-num { color: var(--color-teal); }
    .lb-take.t3 .lb-take-num { color: var(--color-purple); }
    .lb-take.t4 .lb-take-num { color: var(--color-sky); }
    .lb-take.t5 .lb-take-num { color: var(--color-accent-red); }
    .lb-take-body { flex: 1; }
    .lb-take-body h4 {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1rem;
      letter-spacing: -0.01em;
      margin: 0 0 0.15rem;
      color: var(--color-deep);
    }
    .lb-take-body p {
      font-family: var(--font-body);
      font-size: 0.86rem;
      line-height: 1.45;
      color: var(--color-deep);
      margin: 0;
    }
    .lb-take-body p em { color: var(--color-navy); font-style: italic; }

    /* ════════════════════════════════════════════════════
       Adoption ladder — Quoter → Curator → Author → Orchestrator
       Ascending indent suggests the climb.
       ════════════════════════════════════════════════════ */
    .lb-ladder-list {
      list-style: none;
      padding: 0;
      margin: 0 0 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .lb-rung {
      display: flex;
      gap: 1rem;
      align-items: baseline;
      padding: 0.65rem 1rem;
      background: var(--color-warm-white);
      border-radius: 8px;
      border: 1px solid rgba(26,26,46,0.06);
      position: relative;
      overflow: hidden;
    }
    .lb-rung::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 4px;
    }
    .lb-rung.q0 { margin-left: 0; }
    .lb-rung.q1 { margin-left: 1.4rem; }
    .lb-rung.q2 { margin-left: 2.8rem; }
    .lb-rung.q3 { margin-left: 4.2rem; }
    .lb-rung.q0::before { background: var(--color-sky); }
    .lb-rung.q1::before { background: var(--color-teal); }
    .lb-rung.q2::before { background: var(--color-purple); }
    .lb-rung.q3::before { background: var(--color-amber); }
    .lb-rung-tier {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.02rem;
      letter-spacing: -0.01em;
      width: 116px;
      flex-shrink: 0;
    }
    .lb-rung.q0 .lb-rung-tier { color: var(--color-sky); }
    .lb-rung.q1 .lb-rung-tier { color: var(--color-teal); }
    .lb-rung.q2 .lb-rung-tier { color: var(--color-purple); }
    .lb-rung.q3 .lb-rung-tier { color: var(--color-amber); }
    .lb-rung-text {
      font-family: var(--font-body);
      font-size: 0.84rem;
      line-height: 1.4;
      color: var(--color-deep);
      flex: 1;
    }
    .lb-rung-text strong { color: var(--color-navy); font-weight: 700; }
    .lb-ladder-pull {
      font-family: var(--font-body);
      font-size: 0.85rem;
      line-height: 1.5;
      color: var(--color-deep);
      margin: 0;
      padding: 0.75rem 1rem;
      background: var(--color-warm-white);
      border-left: 4px solid var(--color-navy);
      border-radius: 0 8px 8px 0;
    }
    .lb-ladder-pull em { color: var(--color-navy); font-style: italic; font-weight: 600; }

    /* ════════════════════════════════════════════════════
       Day-by-day breakdown — four two-hour days
       ════════════════════════════════════════════════════ */
    .lb-day-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
    }
    .lb-day {
      padding: 0.9rem 1.15rem;
      background: var(--color-warm-white);
      border-radius: 8px;
      border: 1px solid rgba(26,26,46,0.06);
      position: relative;
      overflow: hidden;
    }
    .lb-day::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 4px;
    }
    .lb-day.d1::before { background: var(--color-amber); }
    .lb-day.d2::before { background: var(--color-teal); }
    .lb-day.d3::before { background: var(--color-purple); }
    .lb-day.d4::before { background: var(--color-sky); }
    .lb-day-head {
      display: flex;
      gap: 0.85rem;
      align-items: baseline;
      flex-wrap: wrap;
      margin-bottom: 0.35rem;
    }
    .lb-day-num {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      flex-shrink: 0;
    }
    .lb-day.d1 .lb-day-num { color: var(--color-amber); }
    .lb-day.d2 .lb-day-num { color: var(--color-teal); }
    .lb-day.d3 .lb-day-num { color: var(--color-purple); }
    .lb-day.d4 .lb-day-num { color: var(--color-sky); }
    .lb-day-name {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.12rem;
      letter-spacing: -0.01em;
    }
    .lb-day.d1 .lb-day-name { color: var(--color-amber); }
    .lb-day.d2 .lb-day-name { color: var(--color-teal); }
    .lb-day.d3 .lb-day-name { color: var(--color-purple); }
    .lb-day.d4 .lb-day-name { color: var(--color-sky); }
    .lb-day-beats {
      font-family: var(--font-body);
      font-size: 0.88rem;
      line-height: 1.5;
      color: var(--color-deep);
      margin: 0;
    }
    .lb-day-beats em { color: var(--color-navy); font-style: italic; }

    /* ════════════════════════════════════════════════════
       Positioning statement — big colored serif
       ════════════════════════════════════════════════════ */
    .lb-statement {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.95rem;
      line-height: 1.2;
      letter-spacing: -0.02em;
      color: var(--color-deep);
      margin: 2.25rem 0 0;
    }
    .lb-statement .t { color: var(--color-teal); }
    .lb-statement .a { color: var(--color-amber); }
    .lb-statement .r { color: var(--color-accent-red); }

    /* ════════════════════════════════════════════════════
       Why it works — deploy / ignore / fits / doesn't
       ════════════════════════════════════════════════════ */
    .lb-why-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.85rem;
      margin: 0 0 0.5rem;
    }
    .lb-why-card {
      padding: 1.15rem 1.25rem 1.15rem 1.4rem;
      background: var(--color-warm-white);
      border-radius: 8px;
      border: 1px solid rgba(26,26,46,0.07);
      position: relative;
      overflow: hidden;
    }
    .lb-why-card::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 4px;
    }
    .lb-why-card.w1::before { background: var(--color-amber); }
    .lb-why-card.w2::before { background: var(--color-teal); }
    .lb-why-card.w3::before { background: var(--color-purple); }
    .lb-why-card.w4::before { background: var(--color-sky); }
    .lb-why-card p {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.2rem;
      letter-spacing: -0.01em;
      color: var(--color-deep);
      margin: 0;
    }
    .lb-why-card p em { color: var(--color-navy); font-style: italic; }

    /* ════════════════════════════════════════════════════
       Section title — mid-weight head for a secondary section
       sharing a page (the ladder). Quieter than a page title.
       ════════════════════════════════════════════════════ */
    .lb-section-title {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.5rem;
      letter-spacing: -0.02em;
      line-height: 1.1;
      color: var(--color-deep);
      margin: 2.5rem 0 1.1rem;
    }
    .lb-section-title em { color: var(--color-amber); font-style: italic; }

    /* Cover accent — a short cultivated rule under the masthead */
    .lb-rule {
      width: 60px;
      height: 3px;
      background: var(--color-amber);
      border-radius: 2px;
      margin: 1.25rem 0 0;
    }
  </style>
</head>
<body>

  <div class="lb-shell">

    <div class="print-hint screen-only">
      <span class="accent">Print to PDF →</span>
      Press <kbd>⌘ P</kbd> (or <kbd>Ctrl + P</kbd>). Choose <strong>Save as PDF</strong>. Margins <strong>None</strong>. Background graphics <strong>on</strong>.
    </div>

    <!-- ════════════════════════════════════════
         PAGE 1 · Cover · positioning statement
         ════════════════════════════════════════ -->
    <div class="lb-page">
      <div class="lb-pagebody">
        <h1 class="lb-wordmark">Cultivated <span class="ai">AI</span></h1>
        <p class="lb-verb"><span class="grow">Grow</span>, don't <span class="chase">Chase</span>.</p>
        <div class="lb-rule"></div>

        <p class="lb-statement">We train <span class="t">business leaders</span> to <span class="a">shape AI adoption</span> in their teams, without depending on <span class="r">vendors</span> who don't understand your business.</p>

        <h2 class="lb-page-title" style="margin-top:2.75rem;">The <em>workshop</em>.</h2>
        <div class="lb-spec-grid">
          <div class="lb-spec-row">
            <span class="lb-spec-key">Format</span>
            <span class="lb-spec-val">Four two-hour days. Eight hours in all.</span>
          </div>
          <div class="lb-spec-row">
            <span class="lb-spec-key">Cohort</span>
            <span class="lb-spec-val">~20 people.</span>
          </div>
          <div class="lb-spec-row">
            <span class="lb-spec-key">Coverage</span>
            <span class="lb-spec-val">Foundations, the fifteen principles, skills, and agents.</span>
          </div>
          <div class="lb-spec-row">
            <span class="lb-spec-key">Outcome</span>
            <span class="lb-spec-val">Working skills and a 90-day plan, per leader.</span>
          </div>
        </div>
      </div>

      <div class="lb-footer">
        <span class="brand">Cultivated AI · <em>Grow, don't Chase.</em></span>
        <span class="num">Page 1 of 4</span>
      </div>
    </div>

    <!-- ════════════════════════════════════════
         PAGE 2 · Why it works · the workshop
         ════════════════════════════════════════ -->
    <div class="lb-page">
      <div class="lb-pagebody">
        <span class="lb-section-label">The discipline · <span class="accent">why it works</span></span>
        <h2 class="lb-page-title">The leaders winning learned to <em>think clearly</em>.</h2>
        <p class="lb-page-sub">About AI, in the context of <strong>their own</strong> business. With principles that hold up as the tools change every quarter.</p>
        <div class="lb-why-grid">
          <div class="lb-why-card w1"><p>What to <em>deploy</em>.</p></div>
          <div class="lb-why-card w2"><p>What to <em>ignore</em>.</p></div>
          <div class="lb-why-card w3"><p>Where it <em>fits</em>.</p></div>
          <div class="lb-why-card w4"><p>Where it <em>doesn't</em>.</p></div>
        </div>

        <h3 class="lb-section-title">Where your organisation <em>climbs</em>.</h3>
        <ol class="lb-ladder-list">
          <li class="lb-rung q0">
            <span class="lb-rung-tier">Quoter</span>
            <span class="lb-rung-text">Quotes the machine. Occasional chat, tried it once. <strong>The rung to escape.</strong></span>
          </li>
          <li class="lb-rung q1">
            <span class="lb-rung-tier">Curator</span>
            <span class="lb-rung-text">Curates outputs. Daily drafts and quick answers.</span>
          </li>
          <li class="lb-rung q2">
            <span class="lb-rung-tier">Author</span>
            <span class="lb-rung-text">Authors with AI. Three or more AI-assisted tasks a day, embedded in the work.</span>
          </li>
          <li class="lb-rung q3">
            <span class="lb-rung-tier">Orchestrator</span>
            <span class="lb-rung-text">Orchestrates systems. Agents run the work; people set the direction.</span>
          </li>
        </ol>
      </div>

      <div class="lb-footer">
        <span class="brand">Cultivated AI · <em>Grow, don't Chase.</em></span>
        <span class="num">Page 2 of 4</span>
      </div>
    </div>

    <!-- ════════════════════════════════════════
         PAGE 3 · The four days · the ladder
         ════════════════════════════════════════ -->
    <div class="lb-page">
      <div class="lb-pagebody">
        <span class="lb-section-label">The agenda · <span class="accent">day by day</span></span>
        <h2 class="lb-page-title">The <em>four days</em>.</h2>
        <p class="lb-page-sub">Eight hours, split into four two-hour sessions.</p>

        <ol class="lb-day-list">
          <li class="lb-day d1">
            <div class="lb-day-head">
              <span class="lb-day-num">Day 1 · 2 hrs</span>
              <span class="lb-day-name">From neurons to tokens</span>
            </div>
            <p class="lb-day-beats">How the human brain works, bridged to neural networks and then to LLMs. Context, tokens, and token economics made concrete, so <em>choosing the right model becomes obvious</em>. The first hands-on principles.</p>
          </li>
          <li class="lb-day d2">
            <div class="lb-day-head">
              <span class="lb-day-num">Day 2 · 2 hrs</span>
              <span class="lb-day-name">The fifteen principles, on the keyboard</span>
            </div>
            <p class="lb-day-beats">The full fifteen-principle approach for getting real work out of AI. Framing, asking, evaluating, cross-checking, iterating. <em>Each leader practises on their own real work.</em></p>
          </li>
          <li class="lb-day d3">
            <div class="lb-day-head">
              <span class="lb-day-num">Day 3 · 2 hrs</span>
              <span class="lb-day-name">Skills you build</span>
            </div>
            <p class="lb-day-beats">What an AI skill is, and how to find, tune, and compose your own. Plus a first taste of agents: <em>Chrome extensions that automate the daily tasks you repeat</em>.</p>
          </li>
          <li class="lb-day d4">
            <div class="lb-day-head">
              <span class="lb-day-num">Day 4 · 2 hrs</span>
              <span class="lb-day-name">Skills you share, and a 90-day plan</span>
            </div>
            <p class="lb-day-beats">Moving skills from one desk to the team, then across the company. Where each person and team sits on the ladder, and a concrete <em>90-day plan to become India's most AI-forward D2C org</em>.</p>
          </li>
        </ol>
      </div>

      <div class="lb-footer">
        <span class="brand">Cultivated AI · <em>Grow, don't Chase.</em></span>
        <span class="num">Page 3 of 4</span>
      </div>
    </div>

    <!-- ════════════════════════════════════════
         PAGE 4 · Takeaways · CTA
         ════════════════════════════════════════ -->
    <div class="lb-page">
      <div class="lb-pagebody">
        <span class="lb-section-label">The <span class="accent">takeaways</span></span>
        <h2 class="lb-page-title">What each leader <em>walks out with</em>.</h2>

        <ol class="lb-take-list">
          <li class="lb-take t1">
            <span class="lb-take-num">01</span>
            <div class="lb-take-body">
              <h4>Evaluate any AI tool</h4>
              <p>A clear way to judge which AI tools earn a place in your business and which do not.</p>
            </div>
          </li>
          <li class="lb-take t2">
            <span class="lb-take-num">02</span>
            <div class="lb-take-body">
              <h4>Map functions to AI, or not</h4>
              <p>A framework for matching each business function to the right level of AI, from full automation to hands-off.</p>
            </div>
          </li>
          <li class="lb-take t3">
            <span class="lb-take-num">03</span>
            <div class="lb-take-body">
              <h4>Find, tune, and compose skills</h4>
              <p>Hands-on ability to find AI skills, tune them to your voice, and combine them into bigger workflows.</p>
            </div>
          </li>
          <li class="lb-take t4">
            <span class="lb-take-num">04</span>
            <div class="lb-take-body">
              <h4>A skills plan for your teams</h4>
              <p>A plan for how skills evolve and spread between teams, so good work compounds instead of staying siloed.</p>
            </div>
          </li>
          <li class="lb-take t5">
            <span class="lb-take-num">05</span>
            <div class="lb-take-body">
              <h4>A 90-day plan</h4>
              <p>A concrete 90-day plan to become <em>India's most AI-forward D2C organisation</em>.</p>
            </div>
          </li>
        </ol>
      </div>

      <div class="lb-footer">
        <span class="brand">Cultivated AI · <em>Grow, don't Chase.</em></span>
        <span class="num">Page 4 of 4</span>
      </div>
    </div>

  </div>

