---
export const prerender = true;
import '../../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import GtagHead from '../../components/analytics/GtagHead.astro';
import HeadSEO from '../../components/seo/HeadSEO.astro';
import DeslopLab from '../../components/tools/DeslopLab';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>The De-slop Lab · Cultivated AI</title>
    <HeadSEO
      title="The De-slop Lab · Cultivated AI"
      description="Spot the AI tells, ban them, and build a de-slop prompt in your own voice. Then watch the same text come back sounding like you."
      path="/tools/deslop"
    />
    <GtagHead />
    <style>
      .tool-page {
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
        padding-bottom: 4rem;
      }
      .tool-page::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
          radial-gradient(ellipse 60% 50% at 18% 22%, rgba(233, 69, 96, 0.05) 0%, transparent 70%),
          radial-gradient(ellipse 50% 50% at 85% 55%, rgba(123, 97, 255, 0.05) 0%, transparent 70%);
        pointer-events: none;
      }
      .tool-header {
        text-align: center;
        padding: 3rem 1.5rem 0;
        position: relative;
        z-index: 1;
      }
      .tool-logo {
        font-family: var(--font-heading);
        font-size: clamp(1rem, 2.5vw, 1.2rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--color-deep);
        opacity: 0.7;
      }
      .tool-kicker {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #7B61FF;
        margin-top: 0.35rem;
      }
      .tool-hero {
        max-width: 620px;
        margin: 0 auto;
        padding: 2rem 1.5rem 2.25rem;
        text-align: center;
        position: relative;
        z-index: 1;
      }
      .tool-hero h1 {
        font-family: var(--font-heading);
        font-size: clamp(2.1rem, 6vw, 3rem);
        font-weight: 800;
        color: var(--color-deep);
        margin: 0 0 0.75rem;
        line-height: 1.1;
        letter-spacing: -0.03em;
      }
      .tool-hero p {
        font-family: var(--font-body);
        font-size: 1.05rem;
        color: var(--color-subtle);
        line-height: 1.65;
        margin: 0;
      }
      .tool-main { position: relative; z-index: 1; }
      .tool-foot {
        max-width: 620px;
        margin: 2.5rem auto 0;
        padding: 0 1.5rem;
        text-align: center;
        position: relative;
        z-index: 1;
      }
      .tool-foot p {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 4px 8px;
        font-family: var(--font-mono);
        font-size: 0.66rem;
        color: var(--color-subtle);
        letter-spacing: 0.03em;
        line-height: 1.7;
        margin: 0;
      }
      .tool-foot p span { white-space: nowrap; }
      @media (max-width: 640px) {
        .tool-header { padding-top: 2rem; }
      }
    </style>
  </head>
  <body>
    <div class="tool-page">
      <header class="tool-header">
        <div class="tool-logo">Cultivated AI</div>
        <div class="tool-kicker">The De-slop Lab</div>
      </header>

      <section class="tool-hero">
        <h1>Sound like you.</h1>
        <p>
          AI writing has tells. Spot them in a real sample, turn them into a
          ban list, add your own voice, and watch the same text come back
          sounding like a person. The prompt you build here is yours to keep.
        </p>
      </section>

      <div class="tool-main">
        <DeslopLab client:only="react" />
      </div>

      <div class="tool-foot">
        <p>
          <span>Free to use</span>
          <span>· 40 live rewrites per device per day</span>
          <span>· your prompt saves on this device only</span>
        </p>
      </div>
    </div>
    <Analytics />
  </body>
</html>
