---
export const prerender = true;
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Cultivated AI · For Schools · A briefing for school heads</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&display=swap" />
  <style>
    /* ══════════════════════════════════════════════════════
       Cultivated AI · For Schools · A briefing for school heads
       A4 portrait. 6 pages. Designed for print → PDF.
       Mirrors for-owners.astro structure, teal accent throughout.
       ══════════════════════════════════════════════════════ */

    html, body {
      margin: 0;
      padding: 0;
      background: #E5E2DC;
      color: var(--color-deep);
      font-family: var(--font-body);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    body::before { display: none !important; }

    .br-shell {
      max-width: 210mm;
      margin: 0 auto;
      padding: 2rem 0;
    }

    .br-page {
      width: 210mm;
      min-height: 297mm;
      background: var(--color-cream);
      box-shadow: 0 10px 40px rgba(15,52,96,0.12);
      margin: 0 auto 2rem;
      padding: 18mm 18mm 22mm;
      box-sizing: border-box;
      position: relative;
      overflow: hidden;
    }
    .br-page:last-child { margin-bottom: 0; }

    .br-footer {
      position: absolute;
      bottom: 8mm;
      left: 18mm;
      right: 18mm;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-subtle);
      border-top: 1px solid rgba(26,26,46,0.08);
      padding-top: 6mm;
    }
    .br-footer .brand { color: var(--color-deep); font-weight: 700; }
    .br-footer .brand em { color: var(--color-teal); font-style: italic; font-weight: 600; letter-spacing: 0.05em; }

    @media print {
      @page { size: A4 portrait; margin: 0; }
      html, body { background: var(--color-cream) !important; }
      .br-shell { padding: 0; max-width: none; }
      .br-page {
        margin: 0 !important;
        box-shadow: none !important;
        page-break-after: always;
        break-after: page;
        width: 210mm !important;
        height: 297mm !important;
        min-height: 297mm !important;
      }
      .br-page:last-child { page-break-after: auto; break-after: auto; }
      .screen-only { display: none !important; }
    }

    .print-hint {
      max-width: 210mm;
      margin: 0 auto 1.5rem;
      padding: 0.85rem 1.25rem;
      background: var(--color-warm-white);
      border: 1px solid rgba(22,199,154,0.4);
      border-radius: 8px;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--color-navy);
    }
    .print-hint kbd {
      background: rgba(15,52,96,0.08);
      padding: 1px 6px;
      border-radius: 3px;
      font-size: 0.78rem;
    }
    .print-hint .accent { color: var(--color-teal); font-weight: 700; }

    /* ─── Shared atoms ─── */
    .br-eyebrow {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--color-teal);
      margin: 0 0 1rem;
    }
    .br-section-label {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--color-subtle);
      margin: 1.75rem 0 0.85rem;
    }
    .br-section-label .accent { color: var(--color-teal); }

    .br-page-title {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 2.5rem;
      letter-spacing: -0.03em;
      line-height: 1.05;
      margin: 0 0 0.9rem;
      color: var(--color-deep);
    }
    .br-page-title em { color: var(--color-teal); font-style: italic; }
    .br-page-sub {
      font-family: var(--font-body);
      font-style: italic;
      font-size: 1rem;
      line-height: 1.5;
      color: var(--color-subtle);
      margin: 0 0 1.5rem;
      max-width: 60ch;
    }

    .br-prose p {
      font-family: var(--font-body);
      font-size: 1rem;
      line-height: 1.65;
      color: var(--color-deep);
      margin: 0 0 1rem;
      max-width: 64ch;
    }
    .br-prose p em { color: var(--color-navy); font-style: italic; font-weight: 600; }
    .br-prose p strong { color: var(--color-deep); font-weight: 700; }
    .br-prose p:last-child { margin-bottom: 0; }

    .br-example {
      margin: 1.25rem 0;
      padding: 0.95rem 1.25rem;
      background: var(--color-warm-white);
      border-left: 3px solid var(--color-accent-red);
      border-radius: 0 8px 8px 0;
    }
    .br-example .label {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--color-accent-red);
      margin: 0 0 0.4rem;
    }
    .br-example p {
      font-family: var(--font-body);
      font-size: 0.95rem;
      line-height: 1.55;
      color: var(--color-deep);
      margin: 0;
    }
    .br-example p em { color: var(--color-navy); font-style: italic; font-weight: 600; }

    /* ─── Page 1 · Cover ─── */
    .br-cover-eyebrow {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--color-teal);
      margin: 0 0 1rem;
    }
    .br-wordmark {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 4.5rem;
      line-height: 1;
      letter-spacing: -0.03em;
      margin: 0;
      color: var(--color-deep);
    }
    .br-wordmark .ai { color: var(--color-teal); font-style: italic; }
    .br-verb {
      font-family: var(--font-heading);
      font-weight: 700;
      font-style: italic;
      font-size: 1.7rem;
      color: var(--color-deep);
      margin: 1rem 0 0;
    }
    .br-verb .grow { color: var(--color-teal); }
    .br-verb .chase { color: var(--color-accent-red); text-decoration: line-through; text-decoration-thickness: 2px; text-decoration-color: rgba(233,69,96,0.5); }

    .br-positioning {
      margin: 2.25rem 0 0;
      padding: 0;
    }
    .br-positioning p {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 2rem;
      line-height: 1.25;
      letter-spacing: -0.02em;
      color: var(--color-deep);
      margin: 0;
      max-width: 22ch;
    }
    .br-positioning p .who { color: var(--color-teal); }
    .br-positioning p .what { color: var(--color-amber); }
    .br-positioning p .against { color: var(--color-accent-red); }

    /* ─── Page 2 · Disciplines + stages ─── */
    .br-disciplines {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
      margin: 0.5rem 0 0;
    }
    .br-discipline {
      padding: 0.85rem 1.05rem;
      background: var(--color-warm-white);
      border-radius: 8px;
      border: 1px solid rgba(26,26,46,0.07);
      border-left: 3px solid var(--color-teal);
    }
    .br-discipline .d-num {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--color-teal);
      margin: 0 0 0.25rem;
    }
    .br-discipline .d-title {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1rem;
      letter-spacing: -0.01em;
      color: var(--color-deep);
      margin: 0 0 0.2rem;
    }
    .br-discipline .d-title em { color: var(--color-teal); font-style: italic; }
    .br-discipline .d-body {
      font-family: var(--font-body);
      font-size: 0.82rem;
      line-height: 1.45;
      color: var(--color-subtle);
      margin: 0;
    }

    .br-stages-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }
    .br-stage-row {
      display: flex;
      gap: 1rem;
      padding: 0.85rem 1.1rem;
      background: var(--color-warm-white);
      border-radius: 8px;
      border: 1px solid rgba(26,26,46,0.06);
      align-items: baseline;
      position: relative;
      overflow: hidden;
    }
    .br-stage-row::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 4px;
    }
    .br-stage-row.s1::before { background: var(--color-teal); }
    .br-stage-row.s2::before { background: var(--color-amber); }
    .br-stage-row.s3::before { background: var(--color-purple); }
    .br-stage-row.s4::before { background: var(--color-accent-red); }
    .br-stage-num {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      width: 56px;
      flex-shrink: 0;
    }
    .br-stage-row.s1 .br-stage-num { color: var(--color-teal); }
    .br-stage-row.s2 .br-stage-num { color: var(--color-amber); }
    .br-stage-row.s3 .br-stage-num { color: var(--color-purple); }
    .br-stage-row.s4 .br-stage-num { color: var(--color-accent-red); }
    .br-stage-name {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.05rem;
      letter-spacing: -0.01em;
      width: 110px;
      flex-shrink: 0;
    }
    .br-stage-row.s1 .br-stage-name { color: var(--color-teal); }
    .br-stage-row.s2 .br-stage-name { color: var(--color-amber); }
    .br-stage-row.s3 .br-stage-name { color: var(--color-purple); }
    .br-stage-row.s4 .br-stage-name { color: var(--color-accent-red); }
    .br-stage-tag {
      font-family: var(--font-body);
      font-size: 0.92rem;
      line-height: 1.45;
      color: var(--color-deep);
      flex: 1;
    }
    .br-stage-tag em { color: var(--color-navy); font-style: italic; }

    /* Compact 4-across stage card variant (page 6) */
    .br-stages-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.6rem;
      margin: 0.5rem 0 1rem;
    }
    .br-stage-card {
      padding: 0.85rem 0.95rem;
      background: var(--color-warm-white);
      border-radius: 8px;
      border: 1px solid rgba(26,26,46,0.07);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .br-stage-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 3px;
      height: 100%;
    }
    .br-stage-card.s1::before { background: var(--color-teal); }
    .br-stage-card.s2::before { background: var(--color-amber); }
    .br-stage-card.s3::before { background: var(--color-purple); }
    .br-stage-card.s4::before { background: var(--color-accent-red); }
    .br-stage-card .br-stage-num {
      width: auto;
      font-size: 0.6rem;
    }
    .br-stage-card .br-stage-name {
      width: auto;
      font-size: 1.05rem;
      margin: 0.1rem 0 0.3rem;
    }
    .br-stage-card.s1 .br-stage-name { color: var(--color-teal); }
    .br-stage-card.s2 .br-stage-name { color: var(--color-amber); }
    .br-stage-card.s3 .br-stage-name { color: var(--color-purple); }
    .br-stage-card.s4 .br-stage-name { color: var(--color-accent-red); }
    .br-stage-card .br-stage-tag {
      flex: 0 1 auto;
      font-size: 0.85rem;
      line-height: 1.4;
    }

    /* ─── Page 3 · Anjali ─── */
    .br-anjali-intro {
      font-family: var(--font-body);
      font-size: 1rem;
      line-height: 1.6;
      color: var(--color-deep);
      margin: 0 0 1.25rem;
      max-width: 64ch;
    }
    .br-anjali-intro em { color: var(--color-navy); font-style: italic; font-weight: 600; }

    .br-anjali-stages {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }
    .br-anjali-stage {
      padding: 0.95rem 1.15rem;
      background: var(--color-warm-white);
      border-radius: 8px;
      border: 1px solid rgba(26,26,46,0.07);
      position: relative;
      overflow: hidden;
    }
    .br-anjali-stage::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 4px;
    }
    .br-anjali-stage.s1::before { background: var(--color-teal); }
    .br-anjali-stage.s2::before { background: var(--color-amber); }
    .br-anjali-stage.s3::before { background: var(--color-purple); }
    .br-anjali-stage.s4::before { background: var(--color-accent-red); }
    .br-anjali-stage .ps-head {
      display: flex;
      gap: 0.75rem;
      align-items: baseline;
      margin: 0 0 0.4rem;
    }
    .br-anjali-stage .ps-num {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }
    .br-anjali-stage.s1 .ps-num { color: var(--color-teal); }
    .br-anjali-stage.s2 .ps-num { color: var(--color-amber); }
    .br-anjali-stage.s3 .ps-num { color: var(--color-purple); }
    .br-anjali-stage.s4 .ps-num { color: var(--color-accent-red); }
    .br-anjali-stage h3 {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.1rem;
      letter-spacing: -0.01em;
      margin: 0;
    }
    .br-anjali-stage.s1 h3 { color: var(--color-teal); }
    .br-anjali-stage.s2 h3 { color: var(--color-amber); }
    .br-anjali-stage.s3 h3 { color: var(--color-purple); }
    .br-anjali-stage.s4 h3 { color: var(--color-accent-red); }
    .br-anjali-stage p.lede {
      font-family: var(--font-body);
      font-size: 0.92rem;
      line-height: 1.5;
      color: var(--color-deep);
      margin: 0 0 0.4rem;
    }
    .br-anjali-stage p.lede em { color: var(--color-navy); font-style: italic; font-weight: 600; }
    .br-anjali-stage ul {
      list-style: none;
      padding: 0;
      margin: 0.2rem 0 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem 0.5rem;
    }
    .br-anjali-stage ul li {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.02em;
      padding: 3px 9px;
      border-radius: 100px;
      background: var(--color-cream);
      border: 1px solid rgba(26,26,46,0.1);
      color: var(--color-deep);
    }
    .br-anjali-stage.s1 ul li { border-color: rgba(22,199,154,0.35); }
    .br-anjali-stage.s2 ul li { border-color: rgba(245,166,35,0.35); }
    .br-anjali-stage.s3 ul li { border-color: rgba(123,97,255,0.35); }
    .br-anjali-stage.s4 ul li { border-color: rgba(233,69,96,0.35); }

    /* ─── Pages 4 & 5 · Case-study cards ─── */
    .br-paired-cases {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin: 1rem 0 1.25rem;
    }
    .br-paired-case {
      padding: 1.2rem 1.4rem 1.4rem;
      background: var(--color-warm-white);
      border-radius: 10px;
      border: 1px solid rgba(26,26,46,0.07);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }
    .br-paired-case::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 4px;
    }
    .br-paired-case.estonia::before { background: var(--color-teal); }
    .br-paired-case.sa::before { background: var(--color-purple); }
    .br-paired-case.honest::before { background: var(--color-amber); }
    .br-paired-case.lausd::before { background: var(--color-accent-red); }
    .br-paired-case.korea::before { background: var(--color-accent-red); }
    .br-paired-case.deepfake::before { background: var(--color-accent-red); }
    .br-paired-case .case-eyebrow {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      margin: 0;
    }
    .br-paired-case.estonia .case-eyebrow { color: var(--color-teal); }
    .br-paired-case.sa .case-eyebrow { color: var(--color-purple); }
    .br-paired-case.honest .case-eyebrow { color: var(--color-amber); }
    .br-paired-case.lausd .case-eyebrow { color: var(--color-accent-red); }
    .br-paired-case.korea .case-eyebrow { color: var(--color-accent-red); }
    .br-paired-case.deepfake .case-eyebrow { color: var(--color-accent-red); }
    .br-paired-case .case-name {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.85rem;
      letter-spacing: -0.02em;
      line-height: 1;
      margin: 0;
      color: var(--color-deep);
    }
    .br-paired-case .case-stat { margin: 0; }
    .br-paired-case .case-stat .num {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.5rem;
      letter-spacing: -0.02em;
      line-height: 1.05;
      margin: 0 0 0.3rem;
    }
    .br-paired-case.estonia .case-stat .num { color: var(--color-teal); }
    .br-paired-case.sa .case-stat .num { color: var(--color-purple); }
    .br-paired-case.honest .case-stat .num { color: var(--color-amber); }
    .br-paired-case.lausd .case-stat .num { color: var(--color-accent-red); }
    .br-paired-case.korea .case-stat .num { color: var(--color-accent-red); }
    .br-paired-case.deepfake .case-stat .num { color: var(--color-accent-red); }
    .br-paired-case .case-stat .label {
      font-family: var(--font-body);
      font-size: 0.85rem;
      line-height: 1.5;
      color: var(--color-deep);
      margin: 0;
    }
    .br-paired-case .case-stat .label em { color: var(--color-navy); font-style: italic; font-weight: 600; }
    .br-paired-case .case-quote {
      margin-top: auto;
      padding-top: 0.85rem;
      border-top: 1px solid rgba(26,26,46,0.1);
    }
    .br-paired-case .case-quote .q {
      font-family: var(--font-body);
      font-style: normal;
      font-weight: 600;
      font-size: 0.92rem;
      line-height: 1.45;
      color: var(--color-deep);
      margin: 0 0 0.4rem;
    }
    .br-paired-case .case-quote .q em { color: var(--color-navy); font-style: italic; font-weight: 700; }
    .br-paired-case .case-quote .attr {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.1em;
      color: var(--color-subtle);
      margin: 0;
    }

    /* Wide card variant · spans both columns */
    .br-paired-case.wide {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "eyebrow eyebrow"
        "name name"
        "stat quote";
      column-gap: 1.75rem;
      row-gap: 0.5rem;
    }
    .br-paired-case.wide .case-eyebrow { grid-area: eyebrow; }
    .br-paired-case.wide .case-name { grid-area: name; margin-bottom: 0.4rem; }
    .br-paired-case.wide .case-stat { grid-area: stat; align-self: center; }
    .br-paired-case.wide .case-quote {
      grid-area: quote;
      margin-top: 0;
      padding-top: 0;
      padding-left: 1.75rem;
      border-top: none;
      border-left: 1px solid rgba(26,26,46,0.12);
      align-self: center;
    }

    .br-why {
      margin-top: 1.25rem;
      padding: 1rem 1.3rem;
      background: var(--color-deep);
      color: var(--color-cream);
      border-radius: 10px;
    }
    .br-why .label {
      font-family: var(--font-mono);
      font-size: 0.6rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--color-teal);
      margin: 0 0 0.4rem;
    }
    .br-why p {
      font-family: var(--font-body);
      font-size: 0.95rem;
      line-height: 1.55;
      margin: 0;
      max-width: 60ch;
    }
    .br-why p em { color: var(--color-teal); font-style: italic; font-weight: 600; }

    /* ─── Page 6 · What we'll do ─── */
    .br-spec-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
      margin: 0.5rem 0 1.25rem;
    }
    .br-spec-row {
      display: grid;
      grid-template-columns: 130px 1fr;
      align-items: baseline;
      column-gap: 1.5rem;
      padding: 0.85rem 0;
      border-bottom: 1px solid rgba(26,26,46,0.07);
    }
