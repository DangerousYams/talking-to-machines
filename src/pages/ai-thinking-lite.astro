---
export const prerender = true;
import '../styles/global.css';

const slides = [
  'cover',
  'positioning',
  'trap',
  'shift',
  'why',
  'discipline',
  'ladder',
  'habits',
  'format',
  'leave',
  'showcase',
  'about',
  'thesis',
  'close',
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>AI Thinking · Pitch (lite)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&display=swap" />
  <style>
    /* ══════════════════════════════════════════════════════
       AI Thinking · pitch deck
       Inherits global tokens. Modeled on cultivated-ai.astro.
       Primary accent: teal (the AI Thinking colour).
       ══════════════════════════════════════════════════════ */
    body.card-deck-page { background: var(--color-cream); }

    .deck-slide {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 4rem 5rem;
      box-sizing: border-box;
    }

    /* ─── Progress rail ─── */
    .progress-rail {
      position: fixed;
      top: 20px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 6px;
      z-index: 50;
      padding: 8px 14px;
      background: rgba(250, 248, 245, 0.75);
      backdrop-filter: blur(10px);
      border-radius: 100px;
      border: 1px solid rgba(26,26,46,0.05);
    }
    .progress-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: rgba(26,26,46,0.15);
      transition: all 0.3s ease;
    }
    .progress-dot.active {
      background: var(--color-teal);
      width: 16px;
      border-radius: 100px;
    }
    .progress-dot.visited { background: rgba(26,26,46,0.35); }

    .slide-num {
      position: absolute;
      bottom: 28px;
      right: 40px;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.15em;
      color: var(--color-subtle);
      opacity: 0.5;
    }

    .brand-mark {
      position: absolute;
      bottom: 28px;
      left: 40px;
      font-family: var(--font-heading);
      font-size: 0.85rem;
      letter-spacing: 0.02em;
      color: var(--color-subtle);
      opacity: 0.55;
    }
    .brand-mark .b-tag { font-style: italic; color: var(--color-teal); }

    .kbd-hint {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-subtle);
      opacity: 0.55;
      z-index: 50;
      transition: opacity 0.5s ease;
      pointer-events: none;
    }
    .kbd-hint.hidden { opacity: 0; }
    .kbd-hint kbd {
      font-family: var(--font-mono);
      background: rgba(26,26,46,0.06);
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 0.7rem;
      margin: 0 2px;
    }

    /* ─── Staggered entrance ─── */
    .stagger > * {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1);
    }
    .deck-slide.is-active .stagger > * { opacity: 1; transform: translateY(0); }
    .deck-slide.is-active .stagger > *:nth-child(1) { transition-delay: 0.1s; }
    .deck-slide.is-active .stagger > *:nth-child(2) { transition-delay: 0.2s; }
    .deck-slide.is-active .stagger > *:nth-child(3) { transition-delay: 0.3s; }
    .deck-slide.is-active .stagger > *:nth-child(4) { transition-delay: 0.4s; }
    .deck-slide.is-active .stagger > *:nth-child(5) { transition-delay: 0.5s; }
    .deck-slide.is-active .stagger > *:nth-child(6) { transition-delay: 0.6s; }
    .deck-slide.is-active .stagger > *:nth-child(7) { transition-delay: 0.7s; }
    .deck-slide.is-active .stagger > *:nth-child(8) { transition-delay: 0.8s; }

    /* ─── Print / export-to-PDF ─── */
    @media print {
      @page { size: 1600px 900px; margin: 0; }
      html, body {
        background: var(--color-cream) !important;
        width: 1600px !important;
        height: auto !important;
      }
      body.card-deck-page::before { display: none !important; }
      .progress-rail, .kbd-hint { display: none !important; }
      .card-deck-container {
        height: auto !important;
        max-height: none !important;
        overflow: visible !important;
        scroll-snap-type: none !important;
      }
      .card-deck-card, .deck-slide {
        width: 1600px !important;
        height: 900px !important;
        scroll-snap-align: none !important;
        page-break-after: always !important;
        break-after: page !important;
        overflow: hidden !important;
      }
      .card-deck-card:last-child, .deck-slide:last-child {
        page-break-after: auto !important;
        break-after: auto !important;
      }
      .stagger > * {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
      * { animation: none !important; }

      .ladder-grid { grid-template-columns: repeat(4, 1fr) !important; gap: 1.5rem !important; }
      .why-grid { grid-template-columns: 1fr 1fr !important; gap: 1.5rem !important; }
      .shift-grid { grid-template-columns: repeat(3, 1fr) !important; gap: 2rem !important; }
      .habits-grid { grid-template-columns: repeat(5, 1fr) !important; gap: 0.7rem !important; }
      .leave-grid { grid-template-columns: repeat(4, 1fr) !important; gap: 1.25rem !important; }
      .format-grid { grid-template-columns: repeat(3, 1fr) !important; gap: 1.5rem !important; }
      .deck-slide { padding: 4rem 5rem !important; }
    }

    .caveat { font-family: 'Caveat', cursive; font-weight: 600; }
    .deck-slide p { max-width: none; }
    .mono-label {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--color-subtle);
    }

    /* ══════════════════════════════════════════════════════
       SLIDE 01 — Cover
       ══════════════════════════════════════════════════════ */
    .slide-cover {
      align-items: center;
      justify-content: center;
      text-align: center;
    }
    .slide-cover .wordmark {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: clamp(5rem, 12vw, 10rem);
      line-height: 1;
      letter-spacing: -0.03em;
      margin: 0;
      color: var(--color-deep);
    }
    .slide-cover .wordmark .ai {
      color: var(--color-teal);
      font-style: italic;
    }
    .slide-cover .tagline {
      font-family: var(--font-heading);
      font-weight: 700;
      font-style: italic;
      font-size: clamp(1.6rem, 2.6vw, 2.2rem);
      color: var(--color-deep);
      margin: 2.5rem auto 0;
      letter-spacing: -0.01em;
      text-align: center;
    }
    .slide-cover .tagline em { color: var(--color-teal); font-style: italic; }
    .slide-cover .audience {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--color-subtle);
      margin-top: 3.5rem;
    }

    /* ══════════════════════════════════════════════════════
       SLIDE 02 — Positioning (Erhart one-liner)
       ══════════════════════════════════════════════════════ */
    .slide-positioning { justify-content: center; }
    .positioning-content {
      max-width: 1100px;
      margin: 0 auto;
      width: 100%;
    }
    .positioning-eyebrow { display: block; margin-bottom: 1.75rem; }
    .positioning-statement {
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: clamp(2.4rem, 4vw, 3.4rem);
      letter-spacing: -0.02em;
      line-height: 1.32;
      margin: 0;
      color: var(--color-deep);
    }
    .positioning-statement .p-who { color: var(--color-teal); }
    .positioning-statement .p-what { color: var(--color-amber); }
    .positioning-statement .p-against { color: var(--color-accent-red); }

    .positioning-key {
      display: flex;
      gap: 2rem;
      margin-top: 2.75rem;
      flex-wrap: wrap;
    }
    .positioning-key-item {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--color-subtle);
    }
    .positioning-key-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
    .positioning-key-item.who .positioning-key-dot { background: var(--color-teal); }
    .positioning-key-item.what .positioning-key-dot { background: var(--color-amber); }
    .positioning-key-item.against .positioning-key-dot { background: var(--color-accent-red); }
    .positioning-key-item.who .label { color: var(--color-teal); }
    .positioning-key-item.what .label { color: var(--color-amber); }
    .positioning-key-item.against .label { color: var(--color-accent-red); }

    /* ══════════════════════════════════════════════════════
       SLIDE 03 — The trap
       ══════════════════════════════════════════════════════ */
    .slide-trap { justify-content: center; align-items: center; text-align: center; }
    .trap-eyebrow {
      font-family: 'Caveat', cursive;
      font-size: 1.7rem;
      color: var(--color-accent-red);
      transform: rotate(-2deg);
      display: inline-block;
      margin-bottom: 1.5rem;
    }
    .trap-headline {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: clamp(4rem, 8vw, 7rem);
      line-height: 1;
      letter-spacing: -0.04em;
      margin: 0 0 2rem;
      color: var(--color-accent-red);
      max-width: 22ch;
    }
    .trap-body {
      font-family: var(--font-body);
      font-size: 1.35rem;
      line-height: 1.55;
      color: var(--color-subtle);
      max-width: 44ch;
      margin: 0 auto 1.4rem;
      text-wrap: balance;
    }
    .trap-punch {
      font-family: var(--font-heading);
      font-style: italic;
      font-weight: 700;
      font-size: 1.85rem;
      line-height: 1.35;
      letter-spacing: -0.01em;
      color: var(--color-navy);
      max-width: 32ch;
      margin: 0 auto;
      text-wrap: balance;
    }

    /* ══════════════════════════════════════════════════════
       SLIDE 04 — The ground is moving (3 cards)
       ══════════════════════════════════════════════════════ */
    .slide-shift { justify-content: center; }
    .shift-content { max-width: 1300px; margin: 0 auto; width: 100%; }
    .shift-headline {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: clamp(2.6rem, 4.8vw, 3.8rem);
      letter-spacing: -0.03em;
      line-height: 1.1;
      margin: 0 0 2.75rem;
      color: var(--color-deep);
      text-align: center;
      max-width: 28ch;
      margin-left: auto;
      margin-right: auto;
    }
    .shift-headline em { color: var(--color-accent-red); font-style: italic; }
    .shift-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }
    .shift-card {
      background: var(--color-warm-white);
      border: 1px solid rgba(26,26,46,0.07);
      border-radius: 14px;
      padding: 1.85rem 1.6rem 1.75rem;
      position: relative;
    }
    .shift-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 4px;
      height: 100%;
      border-radius: 14px 0 0 14px;
    }
    .shift-card.s1::before { background: var(--color-amber); }
    .shift-card.s2::before { background: var(--color-accent-red); }
    .shift-card.s3::before { background: var(--color-purple); }
    .shift-card-num {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      color: var(--color-subtle);
      margin: 0 0 0.6rem;
    }
    .shift-card-name {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.6rem;
      letter-spacing: -0.02em;
      line-height: 1.15;
      margin: 0 0 0.85rem;
      color: var(--color-deep);
    }
    .shift-card.s1 .shift-card-name { color: var(--color-amber); }
    .shift-card.s2 .shift-card-name { color: var(--color-accent-red); }
    .shift-card.s3 .shift-card-name { color: var(--color-purple); }
    .shift-card-text {
      font-family: var(--font-body);
      font-size: 1.05rem;
      line-height: 1.55;
      color: var(--color-deep);
      margin: 0;
    }
    .shift-card-text em { color: var(--color-navy); font-style: italic; font-weight: 600; }

    /* ══════════════════════════════════════════════════════
       SLIDE 05 — Why (the four mechanism questions)
       ══════════════════════════════════════════════════════ */
    .slide-why { justify-content: center; }
    .why-content { max-width: 1320px; margin: 0 auto; width: 100%; }
    .why-headline {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: clamp(2.4rem, 4.4vw, 3.5rem);
      letter-spacing: -0.03em;
      line-height: 1.1;
      margin: 0 0 0.75rem;
      color: var(--color-deep);
      text-align: center;
    }
    .why-headline em { color: var(--color-teal); font-style: italic; }
    .why-sub {
      font-family: var(--font-body);
      font-size: 1.2rem;
      line-height: 1.55;
      color: var(--color-subtle);
      text-align: center;
      max-width: 60ch;
      margin: 0 auto 2.5rem;
    }
    .why-sub strong { color: var(--color-navy); font-weight: 700; }
    .why-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
    .why-card {
      background: var(--color-warm-white);
      border-left: 4px solid var(--color-teal);
      border-radius: 0 12px 12px 0;
      padding: 2.25rem 2rem;
      display: flex;
      align-items: center;
      min-height: 160px;
    }
    .why-q {
      font-family: var(--font-heading);
      font-weight: 800;
      font-style: italic;
      font-size: 1.7rem;
      line-height: 1.2;
      letter-spacing: -0.01em;
      color: var(--color-navy);
      margin: 0;
    }

    /* ══════════════════════════════════════════════════════
       SLIDE 06 — Discipline reveal
       ══════════════════════════════════════════════════════ */
    .slide-discipline { justify-content: center; align-items: center; text-align: center; }
    .discipline-eyebrow { margin-bottom: 1.25rem; }
    .discipline-name {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: clamp(4rem, 9vw, 7.5rem);
      line-height: 1.05;
      letter-spacing: -0.03em;
      margin: 0;
      color: var(--color-deep);
    }
    .discipline-name .ai { color: var(--color-teal); font-style: italic; }
    .discipline-tag {
      font-family: var(--font-body);
      font-style: italic;
      font-size: 1.4rem;
      color: var(--color-subtle);
      margin: 1.75rem 0 0;
      max-width: 60ch;
    }
    .discipline-tag em { color: var(--color-navy); font-style: italic; font-weight: 600; }

    /* ══════════════════════════════════════════════════════
       SLIDE 07 — The Ladder (4 levels)
       ══════════════════════════════════════════════════════ */
    .slide-ladder { justify-content: center; }
    .ladder-content { max-width: 1400px; margin: 0 auto; width: 100%; }
    .ladder-headline {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: clamp(2.6rem, 4.8vw, 3.8rem);
      letter-spacing: -0.03em;
      line-height: 1.1;
      margin: 0 0 0.85rem;
      color: var(--color-deep);
      text-align: center;
    }
    .ladder-headline em { color: var(--color-teal); font-style: italic; }
    .ladder-sub {
      font-family: var(--font-body);
      font-style: italic;
      font-size: 1.2rem;
      color: var(--color-subtle);
      text-align: center;
      margin: 0 auto 2.5rem;
      max-width: 60ch;
    }
    .ladder-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
    .ladder-rung {
      background: var(--color-warm-white);
      border-radius: 14px;
      padding: 1.5rem 1.4rem 1.6rem;
      border-top: 5px solid;
      position: relative;
      min-height: 240px;
      display: flex;
      flex-direction: column;
    }
    .ladder-rung.r1 { border-color: var(--color-accent-red); }
    .ladder-rung.r2 { border-color: var(--color-amber); }
    .ladder-rung.r3 { border-color: var(--color-teal); }
    .ladder-rung.r4 { border-color: var(--color-purple); }
    .ladder-num {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--color-subtle);
      margin: 0 0 0.4rem;
    }
    .ladder-name {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.85rem;
      letter-spacing: -0.02em;
      line-height: 1.05;
      margin: 0 0 0.85rem;
    }
    .ladder-rung.r1 .ladder-name { color: var(--color-accent-red); }
    .ladder-rung.r2 .ladder-name { color: var(--color-amber); }
    .ladder-rung.r3 .ladder-name { color: var(--color-teal); }
    .ladder-rung.r4 .ladder-name { color: var(--color-purple); }
    .ladder-line {
      font-family: var(--font-body);
      font-size: 0.98rem;
      line-height: 1.5;
      color: var(--color-deep);
      margin: 0;
    }
    .ladder-arrow {
      text-align: center;
      margin-top: 1.5rem;
      font-family: 'Caveat', cursive;
      font-size: 1.5rem;
      color: var(--color-subtle);
    }
    .ladder-arrow .accent { color: var(--color-purple); font-weight: 700; }

    /* ══════════════════════════════════════════════════════
       SLIDE 08 — The 15 habits (wall)
       ══════════════════════════════════════════════════════ */
    .slide-habits { justify-content: center; }
    .habits-content { max-width: 1480px; margin: 0 auto; width: 100%; }
    .habits-headline {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: clamp(2.4rem, 4.4vw, 3.5rem);
      letter-spacing: -0.03em;
      line-height: 1.1;
      margin: 0 0 0.6rem;
      color: var(--color-deep);
      text-align: center;
    }
    .habits-headline em { color: var(--color-teal); font-style: italic; }
    .habits-sub {
      font-family: var(--font-body);
      font-style: italic;
      font-size: 1.1rem;
      color: var(--color-subtle);
      text-align: center;
      margin: 0 auto 2rem;
      max-width: 64ch;
    }
    .habits-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 0.7rem;
    }
    .habit {
      background: var(--color-warm-white);
      border-radius: 8px;
      border-left: 3px solid var(--color-teal);
      padding: 1rem 1rem 1.1rem;
      min-height: 100px;
      display: flex;
      flex-direction: column;
    }
    .habit.frame { border-color: var(--color-accent-red); }
    .habit.choose { border-color: var(--color-amber); }
    .habit.comm { border-color: var(--color-teal); }
    .habit.eval { border-color: var(--color-purple); }
    .habit.edge { border-color: var(--color-navy); }
    .habit-num {
      font-family: var(--font-mono);
      font-size: 0.6rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-subtle);
      margin: 0 0 0.25rem;
    }
    .habit-title {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.15rem;
      line-height: 1.2;
      letter-spacing: -0.01em;
      color: var(--color-deep);
      margin: 0;
    }
    .habits-legend {
      display: flex;
      gap: 1.5rem;
      justify-content: center;
      margin-top: 1.5rem;
      flex-wrap: wrap;
    }
    .habits-legend-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-subtle);
    }
    .habits-legend-dot {
      width: 8px; height: 8px; border-radius: 2px;
    }

    /* ══════════════════════════════════════════════════════
       SLIDE 09 — Format
       ══════════════════════════════════════════════════════ */
    .slide-format { justify-content: center; align-items: center; }
    .format-content { max-width: 1300px; margin: 0 auto; width: 100%; }
    .format-headline {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: clamp(2.6rem, 4.8vw, 3.8rem);
      letter-spacing: -0.03em;
      line-height: 1.1;
      margin: 0 0 2.5rem;
      color: var(--color-deep);
      text-align: center;
    }
    .format-headline em { color: var(--color-teal); font-style: italic; }
    .format-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }
    .format-card {
      background: var(--color-warm-white);
      border-top: 4px solid var(--color-teal);
      border-radius: 14px;
      padding: 2rem 1.75rem 2rem;
      text-align: center;
    }
    .format-label {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--color-teal);
      margin: 0 0 0.85rem;
    }
    .format-value {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 2.4rem;
      letter-spacing: -0.02em;
      line-height: 1.05;
      color: var(--color-deep);
      margin: 0 0 0.6rem;
    }
    .format-detail {
      font-family: var(--font-body);
      font-style: italic;
      font-size: 1rem;
      line-height: 1.5;
      color: var(--color-subtle);
      margin: 0;
    }

    /* ══════════════════════════════════════════════════════
       SLIDE 10 — What students leave with
       ══════════════════════════════════════════════════════ */
    .slide-leave { justify-content: center; }
    .leave-content { max-width: 1400px; margin: 0 auto; width: 100%; }
    .leave-headline {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: clamp(2.6rem, 4.8vw, 3.8rem);
      letter-spacing: -0.03em;
      line-height: 1.1;
      margin: 0 0 2.5rem;
      color: var(--color-deep);
      text-align: center;
    }
    .leave-headline em { color: var(--color-teal); font-style: italic; }
    .leave-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
    }
    .leave-card {
      background: var(--color-warm-white);
      border-radius: 14px;
      padding: 1.5rem 1.4rem 1.6rem;
      border-top: 4px solid var(--color-teal);
      min-height: 220px;
      display: flex;
      flex-direction: column;
    }
    .leave-card.c1 { border-color: var(--color-teal); }
    .leave-card.c2 { border-color: var(--color-amber); }
    .leave-card.c3 { border-color: var(--color-purple); }
    .leave-card.c4 { border-color: var(--color-navy); }
    .leave-num {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      color: var(--color-subtle);
      margin: 0 0 0.5rem;
    }
    .leave-name {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.4rem;
      letter-spacing: -0.02em;
      line-height: 1.15;
      color: var(--color-deep);
      margin: 0 0 0.7rem;
    }
    .leave-card.c1 .leave-name { color: var(--color-teal); }
    .leave-card.c2 .leave-name { color: var(--color-amber); }
    .leave-card.c3 .leave-name { color: var(--color-purple); }
    .leave-card.c4 .leave-name { color: var(--color-navy); }
    .leave-body {
