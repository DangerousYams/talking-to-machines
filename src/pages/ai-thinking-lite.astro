    /* ══════════════════════════════════════════════════════
       SLIDE 11 — Showcase Day
       ══════════════════════════════════════════════════════ */
    .slide-showcase { justify-content: center; align-items: center; text-align: center; }
    .showcase-eyebrow {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--color-purple);
      margin-bottom: 1.5rem;
    }
    .showcase-week {
      font-family: 'Caveat', cursive;
      font-size: 2.4rem;
      color: var(--color-purple);
      transform: rotate(-2deg);
      display: inline-block;
      margin-bottom: 1rem;
    }
    .showcase-name {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: clamp(4rem, 8vw, 6.5rem);
      line-height: 1.05;
      letter-spacing: -0.03em;
      margin: 0 0 1.5rem;
      color: var(--color-deep);
    }
    .showcase-name em { color: var(--color-purple); font-style: italic; }
    .showcase-body {
      font-family: var(--font-body);
      font-size: 1.5rem;
      line-height: 1.5;
      color: var(--color-deep);
      max-width: 56ch;
      margin: 0 auto;
    }
    .showcase-body em { color: var(--color-purple); font-style: italic; font-weight: 600; }

    /* ══════════════════════════════════════════════════════
       SLIDE 12 — About Shalin (portrait + poster ticker)
       ══════════════════════════════════════════════════════ */
    .slide-about {
      padding: 3rem 5rem 14rem;
      justify-content: center;
    }
    .about-grid {
      display: grid;
      grid-template-columns: 1.3fr 1fr;
      gap: 5rem;
      align-items: center;
      max-width: 1200px;
      margin: 0 auto;
      width: 100%;
    }
    .about-name {
      font-family: var(--font-heading);
      font-size: clamp(3rem, 5.5vw, 4.5rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1;
      margin: 0.5rem 0 0.75rem;
      color: var(--color-deep);
    }
    .about-subtitle {
      font-family: var(--font-body);
      font-style: italic;
      font-size: 1.15rem;
      color: var(--color-subtle);
      margin: 0 0 2rem;
    }
    .about-credits {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .about-credits li {
      display: flex;
      gap: 14px;
      padding: 0.65rem 0;
      border-bottom: 1px solid rgba(26,26,46,0.06);
    }
    .about-credits li:last-child { border-bottom: none; }
    .credit-dot {
      flex-shrink: 0;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      margin-top: 0.55rem;
    }
    .credit-body strong {
      font-family: var(--font-body);
      font-weight: 700;
      color: var(--color-deep);
      font-size: 1.02rem;
    }
    .credit-body .credit-detail {
      display: block;
      font-family: var(--font-body);
      font-size: 0.92rem;
      color: var(--color-subtle);
      font-style: italic;
      margin-top: 2px;
    }
    .about-portrait {
      position: relative;
      width: 320px;
      height: 320px;
      margin: 0 auto;
      border-radius: 50%;
      overflow: hidden;
      box-shadow:
        0 20px 60px rgba(15,52,96,0.18),
        0 0 0 6px var(--color-cream),
        0 0 0 7px rgba(22,199,154,0.18);
    }
    .about-portrait img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(0.15) contrast(1.02);
    }
    .about-email {
      text-align: center;
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--color-navy);
      margin-top: 1.5rem;
      letter-spacing: 0.02em;
    }
    .poster-ticker {
      position: absolute;
      bottom: 2.5rem;
      left: 0;
      right: 0;
      overflow: hidden;
      mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
    }
    .poster-track {
      display: flex;
      animation: ticker 55s linear infinite;
      width: max-content;
      will-change: transform;
    }
    .poster-track img {
      height: 150px;
      margin-right: 20px;
      border-radius: 6px;
      box-shadow: 0 8px 26px rgba(15,52,96,0.18);
      flex-shrink: 0;
    }
    @keyframes ticker {
      from { transform: translate3d(0, 0, 0); }
      to { transform: translate3d(-50%, 0, 0); }
    }

    /* ══════════════════════════════════════════════════════
       SLIDE 13 — Thesis
       ══════════════════════════════════════════════════════ */
    .slide-thesis { justify-content: center; }
    .thesis-content {
      max-width: 1200px;
      margin: 0 auto;
      width: 100%;
    }
    .thesis-eyebrow {
      font-family: 'Caveat', cursive;
      font-size: 1.7rem;
      color: var(--color-teal);
      transform: rotate(-2deg);
      display: inline-block;
      margin-bottom: 1.5rem;
    }
    .thesis-headline {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: clamp(3rem, 5.6vw, 4.6rem);
      line-height: 1.1;
      letter-spacing: -0.03em;
      margin: 0 0 2rem;
      color: var(--color-deep);
    }
    .thesis-headline em { color: var(--color-teal); font-style: italic; font-weight: 800; }
    .thesis-sub {
      font-family: var(--font-body);
      font-style: italic;
      font-size: 1.4rem;
      line-height: 1.5;
      color: var(--color-subtle);
      max-width: 58ch;
      margin: 0;
    }

    /* ══════════════════════════════════════════════════════
       SLIDE 14 — Close
       ══════════════════════════════════════════════════════ */
    .slide-close {
      align-items: center;
      justify-content: center;
      text-align: center;
    }
    .close-wordmark {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: clamp(4rem, 8vw, 6.5rem);
      line-height: 1;
      letter-spacing: -0.03em;
      margin: 0;
      color: var(--color-deep);
    }
    .close-wordmark .ai { color: var(--color-teal); font-style: italic; }
    .close-tagline {
      font-family: var(--font-heading);
      font-weight: 700;
      font-style: italic;
      font-size: clamp(1.4rem, 2.4vw, 2rem);
      color: var(--color-deep);
      margin: 1.75rem 0 0;
      max-width: 38ch;
    }
    .close-email {
      font-family: var(--font-mono);
      font-size: 1.05rem;
      color: var(--color-navy);
      margin-top: 2.75rem;
      letter-spacing: 0.05em;
    }

    /* ══════════════════════════════════════════════════════
       Responsive
       ══════════════════════════════════════════════════════ */
    @media (max-width: 1100px) {
      .ladder-grid { grid-template-columns: repeat(2, 1fr); }
      .why-grid { grid-template-columns: 1fr; }
      .shift-grid { grid-template-columns: 1fr; }
      .habits-grid { grid-template-columns: repeat(3, 1fr); }
      .leave-grid { grid-template-columns: repeat(2, 1fr); }
      .format-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 768px) {
      .deck-slide { padding: 3rem 2rem; }
      .habits-grid { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</head>
<body class="card-deck-page">

  <div class="progress-rail" id="rail">
    {slides.map((_, i) => <div class="progress-dot" data-idx={i}></div>)}
  </div>

  <div class="kbd-hint" id="kbd-hint">
    <kbd>&larr;</kbd> <kbd>&rarr;</kbd> navigate &middot; <kbd>space</kbd> next
  </div>

  <div class="card-deck-container" id="deck">

    <!-- ═══ 01 · Cover ═══ -->
    <section class="card-deck-card deck-slide slide-cover" data-slide="cover">
      <div class="stagger">
        <h1 class="wordmark"><span class="ai">AI</span> Thinking.</h1>
        <p class="tagline">First principles for any AI, <em>today and tomorrow</em>.</p>
        <p class="audience">A briefing for parents and educators</p>
      </div>
      <div class="brand-mark">AI Thinking &middot; <span class="b-tag">First principles for any AI.</span></div>
      <div class="slide-num">01 &middot; Cover</div>
    </section>

    <!-- ═══ 02 · Positioning ═══ -->
    <section class="card-deck-card deck-slide slide-positioning" data-slide="positioning">
      <div class="positioning-content stagger">
        <h1 class="positioning-statement">
          We teach <span class="p-who">grades 6 through 12</span> to <span class="p-what">think about AI from first principles</span>, so they can effectively use any AI, today or in the future, without losing <span class="p-against">their own thinking</span> along the way.
        </h1>
      </div>
      <div class="brand-mark">AI Thinking &middot; <span class="b-tag">First principles for any AI.</span></div>
      <div class="slide-num">02 &middot; Positioning</div>
    </section>

    <!-- ═══ 03 · The trap ═══ -->
    <section class="card-deck-card deck-slide slide-trap" data-slide="trap">
      <div class="stagger" style="display: flex; flex-direction: column; align-items: center;">
        <span class="trap-eyebrow">The trap.</span>
        <h1 class="trap-headline">Using AI tools isn't thinking.</h1>
        <p class="trap-body">Most AI workshops have students make a poster, a presentation, a song with AI.</p>
        <p class="trap-punch">In this mode the child is no better at thinking than before.</p>
      </div>
      <div class="brand-mark">AI Thinking &middot; <span class="b-tag">First principles for any AI.</span></div>
      <div class="slide-num">03 &middot; The trap</div>
    </section>

    <!-- ═══ 04 · The ground is moving ═══ -->
    <section class="card-deck-card deck-slide slide-shift" data-slide="shift">
      <div class="shift-content stagger">
        <h1 class="shift-headline">By graduation, <em>three things will be true</em>.</h1>
        <div class="shift-grid">
          <div class="shift-card s1">
            <p class="shift-card-num">01 &middot; Tools</p>
            <h2 class="shift-card-name">AI itself keeps changing.</h2>
            <p class="shift-card-text">The model your students will use in five years <em>doesn't exist yet</em>. A workshop built around today's tools is obsolete by graduation.</p>
          </div>
          <div class="shift-card s2">
            <p class="shift-card-num">02 &middot; Default</p>
            <h2 class="shift-card-name">AI use will be assumed.</h2>
            <p class="shift-card-text">Teachers and employers won't ask whether AI was involved. They will ask <em>what the student added on top</em>.</p>
          </div>
          <div class="shift-card s3">
            <p class="shift-card-num">03 &middot; Edge</p>
            <h2 class="shift-card-name">The thinking is the edge.</h2>
            <p class="shift-card-text">When the tools are equal and the use is universal, the student's <em>own judgment is the only differentiator left</em>.</p>
          </div>
        </div>
      </div>
      <div class="brand-mark">AI Thinking &middot; <span class="b-tag">First principles for any AI.</span></div>
      <div class="slide-num">04 &middot; The shift</div>
    </section>

    <!-- ═══ 05 · Why AI behaves the way it does ═══ -->
    <section class="card-deck-card deck-slide slide-why" data-slide="why">
      <div class="why-content stagger">
        <h1 class="why-headline">The students winning at AI think about it from <em>first principles</em>.</h1>
        <p class="why-sub">Most workshops show students <strong>what</strong> AI does. We show them <strong>why</strong>, because the why is what transfers from one model to the next.</p>
        <div class="why-grid">
          <div class="why-card">
            <p class="why-q">Why does AI agree with you when you are wrong?</p>
          </div>
          <div class="why-card">
            <p class="why-q">Why does AI invent things confidently?</p>
          </div>
          <div class="why-card">
            <p class="why-q">Why does AI output always sound like AI?</p>
          </div>
          <div class="why-card">
            <p class="why-q">Why does a long conversation get worse over time?</p>
          </div>
        </div>
      </div>
      <div class="brand-mark">AI Thinking &middot; <span class="b-tag">First principles for any AI.</span></div>
      <div class="slide-num">05 &middot; The why</div>
    </section>

    <!-- ═══ 06 · The discipline ═══ -->
    <section class="card-deck-card deck-slide slide-discipline" data-slide="discipline">
      <div class="stagger" style="display: flex; flex-direction: column; align-items: center;">
        <span class="mono-label discipline-eyebrow">We call this discipline</span>
        <h1 class="discipline-name"><span class="ai">AI</span> Thinking.</h1>
        <p class="discipline-tag">Understand the why, and you can direct any AI well. <em>That understanding outlasts every tool.</em></p>
      </div>
      <div class="brand-mark">AI Thinking &middot; <span class="b-tag">First principles for any AI.</span></div>
      <div class="slide-num">06 &middot; The discipline</div>
    </section>

    <!-- ═══ 07 · The Ladder ═══ -->
    <section class="card-deck-card deck-slide slide-ladder" data-slide="ladder">
      <div class="ladder-content stagger">
        <h1 class="ladder-headline">The four levels of <em>AI Thinking</em>.</h1>
        <p class="ladder-sub">The workshop and 90-day plan are designed to move them up a few levels.</p>
        <ol class="ladder-grid">
          <li class="ladder-rung r1">
            <p class="ladder-num">Level 1</p>
            <h3 class="ladder-name">Quoter.</h3>
            <p class="ladder-line">Copies AI output and submits it as their own. The shortcut. Looks easy. Teaches nothing.</p>
          </li>
          <li class="ladder-rung r2">
            <p class="ladder-num">Level 2</p>
            <h3 class="ladder-name">Curator.</h3>
            <p class="ladder-line">Knows which AI is best for which job. Writing one. Research another. Picture-making another. Picks the right tool every time.</p>
          </li>
          <li class="ladder-rung r3">
            <p class="ladder-num">Level 3</p>
            <h3 class="ladder-name">Author.</h3>
            <p class="ladder-line">Takes what AI gives and makes it theirs. Layers their voice, taste, and judgment. The work sounds like them, not the machine.</p>
          </li>
          <li class="ladder-rung r4">
            <p class="ladder-num">Level 4</p>
            <h3 class="ladder-name">Orchestrator.</h3>
            <p class="ladder-line">Runs many AIs together. Picks the best from each. Turns common tasks into Agentic Skills. Makes something only they could make.</p>
          </li>
        </ol>
        <p class="ladder-arrow">Quoter &rarr; Curator &rarr; Author &rarr; <span class="accent">Orchestrator</span></p>
      </div>
      <div class="brand-mark">AI Thinking &middot; <span class="b-tag">First principles for any AI.</span></div>
      <div class="slide-num">07 &middot; The ladder</div>
    </section>

    <!-- ═══ 08 · The 15 habits ═══ -->
    <section class="card-deck-card deck-slide slide-habits" data-slide="habits">
      <div class="habits-content stagger">
        <h1 class="habits-headline">The fifteen habits of <em>AI Thinking</em>.</h1>
        <p class="habits-sub">Durable principles. True of AI in 2020, true today, true of whichever model ships in 2030.</p>
        <ol class="habits-grid">
          <li class="habit frame">
            <p class="habit-num">01 &middot; Frame</p>
            <p class="habit-title">Learn for the AI of tomorrow.</p>
          </li>
          <li class="habit frame">
            <p class="habit-num">02 &middot; Frame</p>
            <p class="habit-title">It is a communication problem.</p>
          </li>
          <li class="habit frame">
            <p class="habit-num">03 &middot; Frame</p>
            <p class="habit-title">Three moves, on repeat.</p>
          </li>
          <li class="habit choose">
            <p class="habit-num">04 &middot; Choose</p>
            <p class="habit-title">Pick the right AI for the task.</p>
          </li>
          <li class="habit comm">
            <p class="habit-num">05 &middot; Communicate</p>
            <p class="habit-title">Frame the conversation.</p>
          </li>
          <li class="habit comm">
            <p class="habit-num">06 &middot; Communicate</p>
            <p class="habit-title">Examples beat instructions.</p>
          </li>
          <li class="habit comm">
            <p class="habit-num">07 &middot; Communicate</p>
            <p class="habit-title">Ask AI to ask you questions.</p>
          </li>
          <li class="habit eval">
            <p class="habit-num">08 &middot; Recursion</p>
            <p class="habit-title">Ask AI for help with AI.</p>
          </li>
          <li class="habit eval">
            <p class="habit-num">09 &middot; Evaluate</p>
            <p class="habit-title">Iteration is everything.</p>
          </li>
          <li class="habit eval">
            <p class="habit-num">10 &middot; Evaluate</p>
            <p class="habit-title">Don't take the quick win.</p>
          </li>
          <li class="habit eval">
            <p class="habit-num">11 &middot; Evaluate</p>
            <p class="habit-title">Never trust one machine.</p>
          </li>
          <li class="habit eval">
            <p class="habit-num">12 &middot; Evaluate</p>
            <p class="habit-title">Always humanise the output.</p>
          </li>
          <li class="habit edge">
            <p class="habit-num">13 &middot; Edge</p>
            <p class="habit-title">Conviction. Art. Sense. Judgment.</p>
          </li>
          <li class="habit edge">
            <p class="habit-num">14 &middot; Long game</p>
            <p class="habit-title">Sessions become your playbook.</p>
          </li>
          <li class="habit edge">
            <p class="habit-num">15 &middot; Mental model</p>
            <p class="habit-title">Every task is one of three things.</p>
          </li>
        </ol>
        <div class="habits-legend">
          <div class="habits-legend-item"><span class="habits-legend-dot" style="background: var(--color-accent-red);"></span>Frame</div>
          <div class="habits-legend-item"><span class="habits-legend-dot" style="background: var(--color-amber);"></span>Choose</div>
          <div class="habits-legend-item"><span class="habits-legend-dot" style="background: var(--color-teal);"></span>Communicate</div>
          <div class="habits-legend-item"><span class="habits-legend-dot" style="background: var(--color-purple);"></span>Evaluate</div>
          <div class="habits-legend-item"><span class="habits-legend-dot" style="background: var(--color-navy);"></span>Edge</div>
        </div>
      </div>
      <div class="brand-mark">AI Thinking &middot; <span class="b-tag">First principles for any AI.</span></div>
      <div class="slide-num">08 &middot; The fifteen</div>
    </section>

    <!-- ═══ 09 · Format ═══ -->
    <section class="card-deck-card deck-slide slide-format" data-slide="format">
      <div class="format-content stagger">
        <h1 class="format-headline">Format <em>at a glance</em>.</h1>
        <div class="format-grid">
          <div class="format-card">
            <p class="format-label">Length</p>
            <p class="format-value">60 minutes</p>
            <p class="format-detail">One session.</p>
          </div>
          <div class="format-card">
            <p class="format-label">Audience</p>
            <p class="format-value">Grades 6 to 12</p>
            <p class="format-detail">25 or fewer students per session.</p>
          </div>
          <div class="format-card">
